      "header": "#1-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设}A, B, C \\text{三个事件相互独立，下列说法不正确的是( )}.\">\\text{设}A, B, C \\text{三个事件相互独立，下列说法不正确的是( )}.</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} { r } { A \\cap B \\text {与} C \\text {不相互独立} } \\end{array}\">\\begin{array}{l} { r } { A \\cap B \\text {与} C \\text {不相互独立} } \\end{array}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} { r } { A B \\text {与} C \\text {相互独立} } \\end{array}\">\\begin{array}{l} { r } { A B \\text {与} C \\text {相互独立} } \\end{array}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l}A\\cup B\\text{与}C\\text{相互独立} \\end{array}\">\\begin{array}{l}A\\cup B\\text{与}C\\text{相互独立} \\end{array}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\boldsymbol{B} \\text{与} \\boldsymbol{C} \\text{相互独立}\">\\boldsymbol{B} \\text{与} \\boldsymbol{C} \\text{相互独立}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}(1)\\ P[(A\\cup B)C]&amp;=P(AC\\cup BC)=P(AC)+P(BC)-P(ABC)\\\\&amp;=P(A)P(C)+P(B)P(C)-P(A)P(B)P(C)\\\\&amp;=P(C)[P(A)+P(B)-P(AB)]=P(C)P(A\\cup B),\\end{aligned} \\text{故} A\\cup B \\text{与} C \\text{相互独立}. \\begin{aligned}(2)\\qquad P[(AB)C]=P(ABC)=P(A)P(B)P(C)\\\\ [(P(A)P(B)]P(C)=P(AB)P(C),\\end{aligned} \\text{故} AB \\text{与} C \\text{相互独立}.\">\\begin{aligned}(1)\\ P[(A\\cup B)C]&amp;=P(AC\\cup BC)=P(AC)+P(BC)-P(ABC)\\\\&amp;=P(A)P(C)+P(B)P(C)-P(A)P(B)P(C)\\\\&amp;=P(C)[P(A)+P(B)-P(AB)]=P(C)P(A\\cup B),\\end{aligned} \\text{故} A\\cup B \\text{与} C \\text{相互独立}. \\begin{aligned}(2)\\qquad P[(AB)C]=P(ABC)=P(A)P(B)P(C)\\\\ [(P(A)P(B)]P(C)=P(AB)P(C),\\end{aligned} \\text{故} AB \\text{与} C \\text{相互独立}.</div>"
    },
    {
      "id": "q0002",
