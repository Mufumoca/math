      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}P(A \\cup B \\cup C) &amp;= P(A) + P(B) + P(C) \\\\&amp;\\qquad- P(AB) - P(AC) - P(BC) + P(ABC) \\\\&amp;= 3P(A) - 3[P(A)]^2 = \\frac{12}{25}\\,, \\end{aligned}\">\\begin{aligned}P(A \\cup B \\cup C) &amp;= P(A) + P(B) + P(C) \\\\&amp;\\qquad- P(AB) - P(AC) - P(BC) + P(ABC) \\\\&amp;= 3P(A) - 3[P(A)]^2 = \\frac{12}{25}\\,, \\end{aligned}</div>"
