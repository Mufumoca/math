      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由多个相互独立事件的性质：}\\\\&amp;1、\\text{若事件}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{相互独立},\\text{则其中任意}\\,k(1\\leq k\\leq n)\\text{个事件也相互独立}.\\\\&amp;2、\\text{若事件}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{相互独立},\\text{则将}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{中任意}\\,m(1\\leq m\\leq n)\\text{个事件换成它们的对立事件，所得的 }n\\text{个事件仍相互独立}.\\ldots\\\\&amp;\\text{所以}\\,\\overline{A+B}\\text{与}C,\\ \\overline{A-B}\\text{与}C,\\ \\overline{AB}\\text{与}C\\text{是相互独立的，只有}\\overline{C}\\text{与}\\overline{C}\\text{不是}.\\end{aligned}\">\\begin{aligned}&amp;\\text{由多个相互独立事件的性质：}\\\\&amp;1、\\text{若事件}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{相互独立},\\text{则其中任意}\\,k(1\\leq k\\leq n)\\text{个事件也相互独立}.\\\\&amp;2、\\text{若事件}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{相互独立},\\text{则将}\\,A_1,A_2,\\cdots,A_n(n\\geq 2)\\text{中任意}\\,m(1\\leq m\\leq n)\\text{个事件换成它们的对立事件，所得的 }n\\text{个事件仍相互独立}.\\ldots\\\\&amp;\\text{所以}\\,\\overline{A+B}\\text{与}C,\\ \\overline{A-B}\\text{与}C,\\ \\overline{AB}\\text{与}C\\text{是相互独立的，只有}\\overline{C}\\text{与}\\overline{C}\\text{不是}.\\end{aligned}</div>"
