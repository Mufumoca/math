      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{这里考虑通过逆事件的概率求得结果}，A_1,\\ A_2,\\ A_3\\text{至少有一个发生的逆事件就是三者都不发生}，\\text{即} \\overline{A_1}\\overline{A_2}\\overline{A_3}，\\\\&amp;\\text{由于} A_1,\\ A_2,\\ A_3 \\text{是随机试验} E \\text{的三个相互独立的事件}，\\text{所以} \\overline{A_1},\\ \\overline{A_2},\\ \\overline{A_3} \\text{也是相互独立的}，\\text{所以}\\\\&amp;\\quad P(\\overline{A_1}\\overline{A_2}\\overline{A_3})=P(\\overline{A_1})P(\\overline{A_2})P(\\overline{A_3})=(1-\\alpha)(1-\\beta)(1-\\gamma),\\\\&amp;\\text{则} A_1,\\ A_2,\\ A_3 \\text{至少有一个发生的概率是}\\\\&amp;\\quad P(A_1\\cup A_2\\cup A_3)=1-P(\\overline{A_1}\\overline{A_2}\\overline{A_3})=1-(1-\\alpha)(1-\\beta)(1-\\gamma)\\\\&amp;\\quad=\\alpha+\\beta+\\gamma-\\alpha\\beta-\\alpha\\gamma-\\beta\\gamma+a\\beta\\gamma\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{这里考虑通过逆事件的概率求得结果}，A_1,\\ A_2,\\ A_3\\text{至少有一个发生的逆事件就是三者都不发生}，\\text{即} \\overline{A_1}\\overline{A_2}\\overline{A_3}，\\\\&amp;\\text{由于} A_1,\\ A_2,\\ A_3 \\text{是随机试验} E \\text{的三个相互独立的事件}，\\text{所以} \\overline{A_1},\\ \\overline{A_2},\\ \\overline{A_3} \\text{也是相互独立的}，\\text{所以}\\\\&amp;\\quad P(\\overline{A_1}\\overline{A_2}\\overline{A_3})=P(\\overline{A_1})P(\\overline{A_2})P(\\overline{A_3})=(1-\\alpha)(1-\\beta)(1-\\gamma),\\\\&amp;\\text{则} A_1,\\ A_2,\\ A_3 \\text{至少有一个发生的概率是}\\\\&amp;\\quad P(A_1\\cup A_2\\cup A_3)=1-P(\\overline{A_1}\\overline{A_2}\\overline{A_3})=1-(1-\\alpha)(1-\\beta)(1-\\gamma)\\\\&amp;\\quad=\\alpha+\\beta+\\gamma-\\alpha\\beta-\\alpha\\gamma-\\beta\\gamma+a\\beta\\gamma\\,.\\end{aligned}</div>"
