      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由于事件}B\\text{与}C\\text{互不相容，事件}A\\text{与}C\\text{互不相容，则}AC=\\varnothing,\\ BC=\\varnothing,\\ C\\subset \\overline{A},\\ C\\subset \\overline{B}.\\\\&amp;\\text{所以}\\overline{ABC}=C,\\ \\overline{ABC}=AB-ABC=AB,\\\\&amp;\\text{又由于件}A\\text{与}B\\text{相互独立，}\\\\&amp;\\text{则}P(ABC+ABC)=P(\\overline{ABC})+P(\\overline{ABC})=P(C)+P(AB)=0.2+0.5\\times 0.5=0.45\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{由于事件}B\\text{与}C\\text{互不相容，事件}A\\text{与}C\\text{互不相容，则}AC=\\varnothing,\\ BC=\\varnothing,\\ C\\subset \\overline{A},\\ C\\subset \\overline{B}.\\\\&amp;\\text{所以}\\overline{ABC}=C,\\ \\overline{ABC}=AB-ABC=AB,\\\\&amp;\\text{又由于件}A\\text{与}B\\text{相互独立，}\\\\&amp;\\text{则}P(ABC+ABC)=P(\\overline{ABC})+P(\\overline{ABC})=P(C)+P(AB)=0.2+0.5\\times 0.5=0.45\\,.\\end{aligned}</div>"
