      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{设}Y \\text{表示射击}5000 \\text{次击中中目标的次数，则}Y \\sim b(5000,0.001)\\text{。根据中心极限定理，则}Y \\sim N(5,4.995), \\\\ P\\{\\text{击中次数不大于}2\\} = P\\{0 \\leq Y \\leq 2\\} \\\\ = P\\{\\frac{0-5}{\\sqrt{5000 \\times 0.001 \\times 0.999}} \\leq \\frac{Y-5000 \\times 0.001}{\\sqrt{5000 \\times 0.001 \\times 0.999}} \\leq \\frac{2-5}{\\sqrt{5000 \\times 0.001 \\times 0.999}}\\} \\\\ \\approx \\Phi\\left(\\frac{2-5}{\\sqrt{4.995}}\\right) - \\Phi\\left(\\frac{0-5}{\\sqrt{4.995}}\\right) \\approx \\Phi(2.24) - \\Phi(1.34) \\\\ = 0.9874 - 0.9099 = 0.0775.\\end{aligned}\">\\begin{aligned} \\text{设}Y \\text{表示射击}5000 \\text{次击中中目标的次数，则}Y \\sim b(5000,0.001)\\text{。根据中心极限定理，则}Y \\sim N(5,4.995), \\\\ P\\{\\text{击中次数不大于}2\\} = P\\{0 \\leq Y \\leq 2\\} \\\\ = P\\{\\frac{0-5}{\\sqrt{5000 \\times 0.001 \\times 0.999}} \\leq \\frac{Y-5000 \\times 0.001}{\\sqrt{5000 \\times 0.001 \\times 0.999}} \\leq \\frac{2-5}{\\sqrt{5000 \\times 0.001 \\times 0.999}}\\} \\\\ \\approx \\Phi\\left(\\frac{2-5}{\\sqrt{4.995}}\\right) - \\Phi\\left(\\frac{0-5}{\\sqrt{4.995}}\\right) \\approx \\Phi(2.24) - \\Phi(1.34) \\\\ = 0.9874 - 0.9099 = 0.0775.\\end{aligned}</div>"
