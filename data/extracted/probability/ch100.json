      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp; \\text{设}X_{i}=\\left\\{\\begin{matrix}1,&amp; \\text{若第}i \\text{个被保险人发生重大事故},i=1,2,\\cdots,5000, \\text{则}X_{i} \\text{均服从参数为}p=0.005\\text{的两点分布}.\\\\0,&amp; \\text{若第}i \\text{个被保险人热未发生重大事故}\\end{matrix}\\right.\\\\&amp; \\sum_{i=1}^{5000}X_{i}=5000 \\text{个被保险人中一年内发生重大人身事故的人数},\\sum_{i=1}^{5000}X_{i}\\sim b(5000,0.005).\\\\&amp; \\text{保险公司一年内从此项业务得到的总收益为}0.016\\times 5000-2\\times \\sum_{i=1}^{5000}X_{i} \\text{万元}.\\\\&amp; \\text{根据中心极限定理，}\\sum_{i=1}^{5000}X_{i}\\sim N(25,25\\times 0.995)，\\text{于是}\\\\&amp; \\quad P\\left\\{20\\leq 0.016\\times 5000-2\\sum_{i=1}^{5000}X_{i}\\leq 40\\right\\}\\\\&amp; \\quad=P\\left\\{20\\leq \\sum_{i=1}^{5000}X_{i}\\leq 30\\right\\}\\approx \\Phi(\\frac{30-25}{\\sqrt{25\\times 0.995}})-\\Phi(\\frac{20-25}{\\sqrt{25\\times 0.995}})\\\\&amp; \\quad\\approx \\Phi(1)-\\Phi(-1)=2\\Phi(1)-1=0.6826.\\end{aligned}\">\\begin{aligned}&amp; \\text{设}X_{i}=\\left\\{\\begin{matrix}1,&amp; \\text{若第}i \\text{个被保险人发生重大事故},i=1,2,\\cdots,5000, \\text{则}X_{i} \\text{均服从参数为}p=0.005\\text{的两点分布}.\\\\0,&amp; \\text{若第}i \\text{个被保险人热未发生重大事故}\\end{matrix}\\right.\\\\&amp; \\sum_{i=1}^{5000}X_{i}=5000 \\text{个被保险人中一年内发生重大人身事故的人数},\\sum_{i=1}^{5000}X_{i}\\sim b(5000,0.005).\\\\&amp; \\text{保险公司一年内从此项业务得到的总收益为}0.016\\times 5000-2\\times \\sum_{i=1}^{5000}X_{i} \\text{万元}.\\\\&amp; \\text{根据中心极限定理，}\\sum_{i=1}^{5000}X_{i}\\sim N(25,25\\times 0.995)，\\text{于是}\\\\&amp; \\quad P\\left\\{20\\leq 0.016\\times 5000-2\\sum_{i=1}^{5000}X_{i}\\leq 40\\right\\}\\\\&amp; \\quad=P\\left\\{20\\leq \\sum_{i=1}^{5000}X_{i}\\leq 30\\right\\}\\approx \\Phi(\\frac{30-25}{\\sqrt{25\\times 0.995}})-\\Phi(\\frac{20-25}{\\sqrt{25\\times 0.995}})\\\\&amp; \\quad\\approx \\Phi(1)-\\Phi(-1)=2\\Phi(1)-1=0.6826.\\end{aligned}</div>"
