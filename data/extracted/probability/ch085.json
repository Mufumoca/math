      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{设 } X \\text{ 是同时需要调整的部件数，可能值为 } 0,1,2,3, \\\\ \\text{记 } p_i = P\\{X=i\\}, \\ i=0,1,2,3, \\quad \\text{有 } p_0 = 0.9 \\times 0.8 \\times 0.7 = 0.504, \\\\ p_1 = 0.1 \\times 0.8 \\times 0.7 + 0.9 \\times 0.2 \\times 0.7 + 0.9 \\times 0.8 \\times 0.3 = 0.398, \\\\ p_2 = 0.1 \\times 0.2 \\times 0.7 + 0.1 \\times 0.8 \\times 0.3 + 0.9 \\times 0.2 \\times 0.3 = 0.092, \\\\ p_3 = 0.1 \\times 0.2 \\times 0.3 = 0.006, \\end{aligned} \\quad  \\text{故 } X \\text{ 的分布列为} \\begin{array}{|c|c|c|c|c|} \\hline X &amp; 0 &amp; 1 &amp; 2 &amp; 3 \\\\ \\hline p_i &amp; 0.504 &amp; 0.398 &amp; 0.092 &amp; 0.006 \\\\ \\hline \\end{array} \\begin{aligned} E(X) &amp;= 0 \\times 0.504 + 1 \\times 0.398 + 2 \\times 0.092 + 3 \\times 0.006 = 0.6, \\\\ E(X^2) &amp;= 0^2 \\times 0.504 + 1^2 \\times 0.398 + 2^2 \\times 0.092 + 3^2 \\times 0.006 = 0.82, \\\\ D(X) &amp;= 0.82 - 0.6^2 = 0.46. \\end{aligned}\">\\begin{aligned} \\text{设 } X \\text{ 是同时需要调整的部件数，可能值为 } 0,1,2,3, \\\\ \\text{记 } p_i = P\\{X=i\\}, \\ i=0,1,2,3, \\quad \\text{有 } p_0 = 0.9 \\times 0.8 \\times 0.7 = 0.504, \\\\ p_1 = 0.1 \\times 0.8 \\times 0.7 + 0.9 \\times 0.2 \\times 0.7 + 0.9 \\times 0.8 \\times 0.3 = 0.398, \\\\ p_2 = 0.1 \\times 0.2 \\times 0.7 + 0.1 \\times 0.8 \\times 0.3 + 0.9 \\times 0.2 \\times 0.3 = 0.092, \\\\ p_3 = 0.1 \\times 0.2 \\times 0.3 = 0.006, \\end{aligned} \\quad  \\text{故 } X \\text{ 的分布列为} \\begin{array}{|c|c|c|c|c|} \\hline X &amp; 0 &amp; 1 &amp; 2 &amp; 3 \\\\ \\hline p_i &amp; 0.504 &amp; 0.398 &amp; 0.092 &amp; 0.006 \\\\ \\hline \\end{array} \\begin{aligned} E(X) &amp;= 0 \\times 0.504 + 1 \\times 0.398 + 2 \\times 0.092 + 3 \\times 0.006 = 0.6, \\\\ E(X^2) &amp;= 0^2 \\times 0.504 + 1^2 \\times 0.398 + 2^2 \\times 0.092 + 3^2 \\times 0.006 = 0.82, \\\\ D(X) &amp;= 0.82 - 0.6^2 = 0.46. \\end{aligned}</div>"
