      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{依题意知} X\\sim N(2,\\sigma^2)\\text{，由} P\\{2&lt;X&lt;4\\}&amp;=0.3\\text{得} \\\\ P\\{2&lt;X&lt;4\\}&amp;=P\\left\\{\\frac{2-2}{\\sigma}&lt;\\frac{X-2}{\\sigma}&lt;\\frac{4-2}{\\sigma}\\right\\}=\\Phi\\left(\\frac{2}{\\sigma}\\right)-\\Phi(0)=0.3\\,, \\\\ &amp;\\quad\\Phi\\left(\\frac{2}{\\sigma}\\right)=0.8\\,. \\\\ \\text{所以} \\\\ P\\{X&lt;0\\}&amp;=P\\{\\frac{X-2}{\\sigma}&lt;\\frac{0-2}{\\sigma}\\}=\\Phi\\left(-\\frac{2}{\\sigma}\\right)=1-\\Phi\\left(\\frac{2}{\\sigma}\\right)=1-0.8=0.2\\,.\\end{aligned}\">\\begin{aligned} \\text{依题意知} X\\sim N(2,\\sigma^2)\\text{，由} P\\{2&lt;X&lt;4\\}&amp;=0.3\\text{得} \\\\ P\\{2&lt;X&lt;4\\}&amp;=P\\left\\{\\frac{2-2}{\\sigma}&lt;\\frac{X-2}{\\sigma}&lt;\\frac{4-2}{\\sigma}\\right\\}=\\Phi\\left(\\frac{2}{\\sigma}\\right)-\\Phi(0)=0.3\\,, \\\\ &amp;\\quad\\Phi\\left(\\frac{2}{\\sigma}\\right)=0.8\\,. \\\\ \\text{所以} \\\\ P\\{X&lt;0\\}&amp;=P\\{\\frac{X-2}{\\sigma}&lt;\\frac{0-2}{\\sigma}\\}=\\Phi\\left(-\\frac{2}{\\sigma}\\right)=1-\\Phi\\left(\\frac{2}{\\sigma}\\right)=1-0.8=0.2\\,.\\end{aligned}</div>"
