      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由}\\xi\\sim N(0,\\sigma^2),\\ \\text{知}\\ \\frac{\\xi}{\\sigma}\\sim N(0,1).\\\\&amp;\\text{由标准正态分布的性质，知}\\ P\\{\\frac{\\xi}{\\sigma}\\leq k\\}=1-P\\{\\frac{\\xi}{\\sigma}\\leq -k\\},\\ \\text{其中}\\ k\\text{为任意实数. 因此.}\\\\&amp;\\quad P\\{\\xi\\leq \\lambda\\}=1-P\\{\\xi\\leq-\\lambda\\},\\ \\text{其中}\\ \\lambda\\text{是任意实数.}\\\\&amp;\\text{由正态分布的性质及数字特征的性质，知}\\ \\quad|\\lambda|\\xi\\sim N(0,\\lambda^2\\sigma^2),\\ \\xi+\\lambda\\sim N(\\lambda,\\sigma^2).\\end{aligned}\">\\begin{aligned}&amp;\\text{由}\\xi\\sim N(0,\\sigma^2),\\ \\text{知}\\ \\frac{\\xi}{\\sigma}\\sim N(0,1).\\\\&amp;\\text{由标准正态分布的性质，知}\\ P\\{\\frac{\\xi}{\\sigma}\\leq k\\}=1-P\\{\\frac{\\xi}{\\sigma}\\leq -k\\},\\ \\text{其中}\\ k\\text{为任意实数. 因此.}\\\\&amp;\\quad P\\{\\xi\\leq \\lambda\\}=1-P\\{\\xi\\leq-\\lambda\\},\\ \\text{其中}\\ \\lambda\\text{是任意实数.}\\\\&amp;\\text{由正态分布的性质及数字特征的性质，知}\\ \\quad|\\lambda|\\xi\\sim N(0,\\lambda^2\\sigma^2),\\ \\xi+\\lambda\\sim N(\\lambda,\\sigma^2).\\end{aligned}</div>"
