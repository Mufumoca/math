      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{用}S_{1}^{2}\\text{和}S_{2}^{2}\\text{分别表示两个样本方差，由定理知}\\\\&amp;\\quad F=\\frac{S_{1}^{2}/\\sigma_{1}^{2}}{S_{2}^{2}/\\sigma_{2}^{2}}=\\frac{S_{1}^{2}/20}{S_{2}^{2}/35}\\sim F(8-1,10-1)=F(7,9).\\\\&amp;\\text{于是，}\\\\&amp;\\quad P\\{S_{1}^{2}\\geq 2S_{2}^{2}\\}=P\\{\\frac{S_{1}^{2}}{S_{2}^{2}}\\geq 2\\}=P\\{\\frac{S_{1}^{2}/20}{S_{2}^{2}/35}\\geq 2\\times \\frac{35}{20}\\}=P\\{F\\geq 3.5\\}.\\\\&amp;\\text{查}F\\text{分布表得}F_{0.05}(7,9)=3.29,F_{0.025}(7,9)=4.20,\\text{因而}F_{0.025}(7,9)=3.29&lt;3.5&lt;F_{0.025}(7,9)=4.20.\\text{即事件}\\{S_{1}^{2}\\geq 2S_{2}^{2}\\text{的概率介于}0.025\\text{和}0.05\\text{之间，故}0.025\\leq P\\{S_{1}^{2}\\geq 2S_{2}^{2}\\}\\leq 0.05.\\end{aligned}\">\\begin{aligned}&amp;\\text{用}S_{1}^{2}\\text{和}S_{2}^{2}\\text{分别表示两个样本方差，由定理知}\\\\&amp;\\quad F=\\frac{S_{1}^{2}/\\sigma_{1}^{2}}{S_{2}^{2}/\\sigma_{2}^{2}}=\\frac{S_{1}^{2}/20}{S_{2}^{2}/35}\\sim F(8-1,10-1)=F(7,9).\\\\&amp;\\text{于是，}\\\\&amp;\\quad P\\{S_{1}^{2}\\geq 2S_{2}^{2}\\}=P\\{\\frac{S_{1}^{2}}{S_{2}^{2}}\\geq 2\\}=P\\{\\frac{S_{1}^{2}/20}{S_{2}^{2}/35}\\geq 2\\times \\frac{35}{20}\\}=P\\{F\\geq 3.5\\}.\\\\&amp;\\text{查}F\\text{分布表得}F_{0.05}(7,9)=3.29,F_{0.025}(7,9)=4.20,\\text{因而}F_{0.025}(7,9)=3.29&lt;3.5&lt;F_{0.025}(7,9)=4.20.\\text{即事件}\\{S_{1}^{2}\\geq 2S_{2}^{2}\\text{的概率介于}0.025\\text{和}0.05\\text{之间，故}0.025\\leq P\\{S_{1}^{2}\\geq 2S_{2}^{2}\\}\\leq 0.05.\\end{aligned}</div>"
