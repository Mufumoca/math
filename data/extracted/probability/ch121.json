      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{设有实验课的考分总体}X_{1}\\sim N(\\mu_{1},\\sigma^{2}),\\text{无实验课的考分总体}X_{2}\\sim N(\\mu_{2},\\sigma^{2})。\\text{两方差相等但均未知},\\text{求}\\mu_{1}-\\mu_{2}\\text{的}99\\%\\text{的置信区间}，\\text{应选}t\\text{分布变量},\\\\ &amp; \\quad T=\\frac{\\overline{X_{1}}-\\overline{X_{2}}-(\\mu_{1}-\\mu_{2})}{S_{W}\\sqrt{\\frac{1}{n_{1}}+\\frac{1}{n_{2}}}}\\sim t(n_{1}+n_{2}-2),\\\\ &amp; \\text{其中}S_{W}=\\sqrt{\\frac{(n_{1}-1)S_{1}^{2}+(n_{2}-1)S_{2}^{2}}{n_{1}+n_{2}-2}}\\\\ &amp; \\quad\\mu_{1}-\\mu_{2}\\text{的}1-\\alpha\\text{的置信区间为}\\\\ &amp; \\quad\\left(\\overline{X_{1}}-\\overline{X_{2}}\\pm t_{0.2}(n_{1}+n_{2}-2)S_{W}\\sqrt{\\frac{1}{n_{1}}+\\frac{1}{n_{2}}}\\right).\\\\ &amp; \\text{由已知,}\\overline{x_{1}}-\\overline{x_{2}}=84-77=7,\\text{且}\\\\ &amp; \\quad s_{W}=\\sqrt{\\frac{(12-1)\\times 4^{2}+(18-1)\\times 6^{2}}{12+18-2}}\\approx 5.305,\\\\ &amp; \\quad\\sqrt{\\frac{1}{12}+\\frac{1}{18}}\\approx 0.373,\\ 1-\\alpha=0.99,\\ \\frac{\\alpha}{2}=0.005,\\\\ &amp; \\text{查}t\\text{分布表得}t_{0.005}(28)=2.763.\\\\ &amp; \\text{于是,}\\mu_{1}-\\mu_{2}\\text{的}0.99\\text{的置信区间为}\\left(7\\pm 2.763\\times 5.305\\times 0.373\\right),\\text{即}\\left(7\\pm 5.467\\right),\\text{亦即}\\left(1.53,12.47\\right).\\end{aligned}\">\\begin{aligned} &amp; \\text{设有实验课的考分总体}X_{1}\\sim N(\\mu_{1},\\sigma^{2}),\\text{无实验课的考分总体}X_{2}\\sim N(\\mu_{2},\\sigma^{2})。\\text{两方差相等但均未知},\\text{求}\\mu_{1}-\\mu_{2}\\text{的}99\\%\\text{的置信区间}，\\text{应选}t\\text{分布变量},\\\\ &amp; \\quad T=\\frac{\\overline{X_{1}}-\\overline{X_{2}}-(\\mu_{1}-\\mu_{2})}{S_{W}\\sqrt{\\frac{1}{n_{1}}+\\frac{1}{n_{2}}}}\\sim t(n_{1}+n_{2}-2),\\\\ &amp; \\text{其中}S_{W}=\\sqrt{\\frac{(n_{1}-1)S_{1}^{2}+(n_{2}-1)S_{2}^{2}}{n_{1}+n_{2}-2}}\\\\ &amp; \\quad\\mu_{1}-\\mu_{2}\\text{的}1-\\alpha\\text{的置信区间为}\\\\ &amp; \\quad\\left(\\overline{X_{1}}-\\overline{X_{2}}\\pm t_{0.2}(n_{1}+n_{2}-2)S_{W}\\sqrt{\\frac{1}{n_{1}}+\\frac{1}{n_{2}}}\\right).\\\\ &amp; \\text{由已知,}\\overline{x_{1}}-\\overline{x_{2}}=84-77=7,\\text{且}\\\\ &amp; \\quad s_{W}=\\sqrt{\\frac{(12-1)\\times 4^{2}+(18-1)\\times 6^{2}}{12+18-2}}\\approx 5.305,\\\\ &amp; \\quad\\sqrt{\\frac{1}{12}+\\frac{1}{18}}\\approx 0.373,\\ 1-\\alpha=0.99,\\ \\frac{\\alpha}{2}=0.005,\\\\ &amp; \\text{查}t\\text{分布表得}t_{0.005}(28)=2.763.\\\\ &amp; \\text{于是,}\\mu_{1}-\\mu_{2}\\text{的}0.99\\text{的置信区间为}\\left(7\\pm 2.763\\times 5.305\\times 0.373\\right),\\text{即}\\left(7\\pm 5.467\\right),\\text{亦即}\\left(1.53,12.47\\right).\\end{aligned}</div>"
