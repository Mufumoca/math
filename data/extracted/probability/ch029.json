    {
      "id": "q0005",
      "number": 5,
      "header": "#5-Hard",
      "difficulty": "Hard",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{使用了} \\; x \\text{小时的电子管，在以后的} \\; \\Delta x \\text{小时内损坏的概率等于} \\; \\lambda \\Delta x + o(\\Delta x) \\text{，其中} \\; \\lambda &gt; 0 \\text{是常数，} \\\\ \\text{设电子管在损坏前已使用时数} \\; \\lambda \\text{的分布函数为} F(x) \\text{，则电子管在} \\; T \\text{小时内损坏的概率为} \\; (\\; ) \\; . \\end{aligned}\">\\begin{aligned} \\text{使用了} \\; x \\text{小时的电子管，在以后的} \\; \\Delta x \\text{小时内损坏的概率等于} \\; \\lambda \\Delta x + o(\\Delta x) \\text{，其中} \\; \\lambda &gt; 0 \\text{是常数，} \\\\ \\text{设电子管在损坏前已使用时数} \\; \\lambda \\text{的分布函数为} F(x) \\text{，则电子管在} \\; T \\text{小时内损坏的概率为} \\; (\\; ) \\; . \\end{aligned}</div>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"P\\{X\\leq T\\}=1+e^{-\\lambda T}\">P\\{X\\leq T\\}=1+e^{-\\lambda T}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}P\\{X\\leq T\\}=e^{-\\lambda T}\\end{aligned}\">\\begin{aligned}P\\{X\\leq T\\}=e^{-\\lambda T}\\end{aligned}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} { r } { P \\{ X \\leq T \\} = - e ^ { - \\lambda T } } \\end{array}\">\\begin{array}{l} { r } { P \\{ X \\leq T \\} = - e ^ { - \\lambda T } } \\end{array}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} { r } { P \\{ X \\leq T \\} = 1 - e ^ { - \\lambda T } } \\end{array}\">\\begin{array}{l} { r } { P \\{ X \\leq T \\} = 1 - e ^ { - \\lambda T } } \\end{array}</span>"
        }
      ],
      "answer": "D",
      "answer_index": 3,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{因}X\\text{的可能取值充满区间} (0,+\\infty),\\ \\text{故应分段求} \\ F(x)=P\\{X\\leq x\\}.\\\\ \\text{当}x\\leq 0\\text{时}, \\ F(x)=P\\{X\\leq x\\}=P(\\emptyset)=0;\\\\ \\text{当}x&gt;0\\text{时,由题设知}P\\{x\\leq x+\\Delta x/\\{X\\}=\\lambda \\Delta x+o(\\Delta x),\\ \\text{而}\\\\ P\\{x&lt;X\\leq x+\\Delta x/\\{X\\}=\\frac{P\\{x&lt;X\\leq x+\\Delta x,X&gt;x\\}}{P\\{X&gt;x\\}}=\\frac{P\\{x&lt;X\\leq x+\\Delta x\\}}{1-P\\{X\\leq x\\}}=\\frac{F(x+\\Delta x)-F(x)}{1-F(x)},\\\\ \\text{故} \\ \\frac{F(X+\\Delta x)-F(x)}{1-F(x)}=\\lambda \\Delta x+o(\\Delta x),\\ \\text{即}\\\\ \\frac{F(x+\\Delta x)-F(x)}{\\Delta x}=[1-F(x)]\\left[\\lambda+\\frac{o(\\Delta x)}{\\Delta x}\\right],\\\\ \\text{令}o(\\Delta x)\\to 0,\\ \\text{得} \\ F&#x27;(x)=\\lambda[1-F(x)].\\\\ \\text{这是关于}F(x)\\text{的变量可分离微分方程,分离变量}\\frac{dF(x)}{1-F(x)}=\\lambda dx,\\ \\text{积分之得通解为}\\\\ C[1-F(x)]=e^{-\\lambda x}\\ (C\\text{为任意常数}).\\\\ \\text{注意到初始条件}F(0)=0,\\ \\text{故} \\ C=1.\\\\ \\text{于是}F(x)=1-e^{-\\lambda x}, \\ x&gt;0,\\ \\lambda&gt;0,\\ \\text{故}x\\text{的分布函数为}\\\\ F(x)=\\begin{cases} \\ 0, &amp; x\\leq 0\\\\ 1-e^{-\\lambda x}, &amp; x&gt;0 \\end{cases}(\\lambda&gt;0),\\\\ \\text{从而电子管在7小时内损坏的概率为}\\\\ P\\{X\\leq T\\}=F(T)=1-e^{-\\lambda T}.\\end{aligned}\">\\begin{aligned} \\text{因}X\\text{的可能取值充满区间} (0,+\\infty),\\ \\text{故应分段求} \\ F(x)=P\\{X\\leq x\\}.\\\\ \\text{当}x\\leq 0\\text{时}, \\ F(x)=P\\{X\\leq x\\}=P(\\emptyset)=0;\\\\ \\text{当}x&gt;0\\text{时,由题设知}P\\{x\\leq x+\\Delta x/\\{X\\}=\\lambda \\Delta x+o(\\Delta x),\\ \\text{而}\\\\ P\\{x&lt;X\\leq x+\\Delta x/\\{X\\}=\\frac{P\\{x&lt;X\\leq x+\\Delta x,X&gt;x\\}}{P\\{X&gt;x\\}}=\\frac{P\\{x&lt;X\\leq x+\\Delta x\\}}{1-P\\{X\\leq x\\}}=\\frac{F(x+\\Delta x)-F(x)}{1-F(x)},\\\\ \\text{故} \\ \\frac{F(X+\\Delta x)-F(x)}{1-F(x)}=\\lambda \\Delta x+o(\\Delta x),\\ \\text{即}\\\\ \\frac{F(x+\\Delta x)-F(x)}{\\Delta x}=[1-F(x)]\\left[\\lambda+\\frac{o(\\Delta x)}{\\Delta x}\\right],\\\\ \\text{令}o(\\Delta x)\\to 0,\\ \\text{得} \\ F&#x27;(x)=\\lambda[1-F(x)].\\\\ \\text{这是关于}F(x)\\text{的变量可分离微分方程,分离变量}\\frac{dF(x)}{1-F(x)}=\\lambda dx,\\ \\text{积分之得通解为}\\\\ C[1-F(x)]=e^{-\\lambda x}\\ (C\\text{为任意常数}).\\\\ \\text{注意到初始条件}F(0)=0,\\ \\text{故} \\ C=1.\\\\ \\text{于是}F(x)=1-e^{-\\lambda x}, \\ x&gt;0,\\ \\lambda&gt;0,\\ \\text{故}x\\text{的分布函数为}\\\\ F(x)=\\begin{cases} \\ 0, &amp; x\\leq 0\\\\ 1-e^{-\\lambda x}, &amp; x&gt;0 \\end{cases}(\\lambda&gt;0),\\\\ \\text{从而电子管在7小时内损坏的概率为}\\\\ P\\{X\\leq T\\}=F(T)=1-e^{-\\lambda T}.\\end{aligned}</div>"
    },
