      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; (1) \\text{设} \\lambda \\text{表示设备寿命.} \\ A \\text{表示“设备寿命超过1”,} \\ B_i \\text{表示“取出}i \\text{个二等品} \\ (i=0,1,2), \\text{则} \\lambda \\text{的密度函数为} \\\\ &amp; \\quad f_{\\lambda}(x)=\\begin{cases} \\lambda e^{-\\lambda x}, x&gt;0 \\\\ 0, \\ x \\leq 0 \\end{cases} \\quad (\\lambda=i+1, \\, i=0,1,2), \\\\ &amp; \\quad P(B_0)=\\frac{C_{90}^2}{C_{100}^2}, \\quad P(B_1)=\\frac{C_{90}^1 C_{10}^2}{C_{100}^2}, \\quad P(B_2)=\\frac{C_{10}^2}{C_{100}^2}, \\\\ &amp; \\quad P(A|B_0)=\\int_{1}^{+\\infty} e^{-x} dx=e^{-1}, \\\\ &amp; \\quad P(A|B_1)=\\int_{1}^{+\\infty} 2e^{-2x} dx=e^{-2}, \\\\ &amp; \\quad P(A|B_2)=\\int_{1}^{+\\infty} 3e^{-3x} dx=e^{-3}, \\\\ &amp; \\text{由全概率公式:} \\ P(A)=\\sum_{i=0}^{2} P(B_i)P(A|B_i) \\approx 0.32. \\\\ &amp; (2) \\text{由贝叶斯公式:} \\quad P(B_0|A)=\\frac{P(B_0)P(A|B_0)}{P(A)} \\approx 0.93.\\end{aligned}\">\\begin{aligned} &amp; (1) \\text{设} \\lambda \\text{表示设备寿命.} \\ A \\text{表示“设备寿命超过1”,} \\ B_i \\text{表示“取出}i \\text{个二等品} \\ (i=0,1,2), \\text{则} \\lambda \\text{的密度函数为} \\\\ &amp; \\quad f_{\\lambda}(x)=\\begin{cases} \\lambda e^{-\\lambda x}, x&gt;0 \\\\ 0, \\ x \\leq 0 \\end{cases} \\quad (\\lambda=i+1, \\, i=0,1,2), \\\\ &amp; \\quad P(B_0)=\\frac{C_{90}^2}{C_{100}^2}, \\quad P(B_1)=\\frac{C_{90}^1 C_{10}^2}{C_{100}^2}, \\quad P(B_2)=\\frac{C_{10}^2}{C_{100}^2}, \\\\ &amp; \\quad P(A|B_0)=\\int_{1}^{+\\infty} e^{-x} dx=e^{-1}, \\\\ &amp; \\quad P(A|B_1)=\\int_{1}^{+\\infty} 2e^{-2x} dx=e^{-2}, \\\\ &amp; \\quad P(A|B_2)=\\int_{1}^{+\\infty} 3e^{-3x} dx=e^{-3}, \\\\ &amp; \\text{由全概率公式:} \\ P(A)=\\sum_{i=0}^{2} P(B_i)P(A|B_i) \\approx 0.32. \\\\ &amp; (2) \\text{由贝叶斯公式:} \\quad P(B_0|A)=\\frac{P(B_0)P(A|B_0)}{P(A)} \\approx 0.93.\\end{aligned}</div>"
