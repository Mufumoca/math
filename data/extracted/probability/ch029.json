      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{因为} K \\sim U(0,5),\\ \\text{所以} f_{K}(k) = \\begin{cases} 1/5, &amp; 0 &lt; k &lt; 5 \\\\ 0, &amp; \\text{其它} \\end{cases}, \\\\ &amp; \\text{方程} \\ 4x^{2} + 4Kx + K + 2 = 0 \\text{有实根的充要条件为} (4K)^{2} - 4 \\cdot 4(K+2) \\geq 0, \\text{即} \\\\ &amp; \\qquad K^{2} - K - 2 \\geq 0, \\\\ &amp; \\text{亦即} (k-2)(K+1) \\geq 0, \\ \\text{解得} K \\geq 2 (K \\leq -1 \\text{舍去}), \\ \\text{所以} \\\\ &amp; \\qquad P\\{\\text{方程有实根}\\} = P\\{K \\geq 2\\} = \\int_{-\\frac{1}{2}}^{\\frac{1}{2}} \\! \\! dx = \\frac{3}{5}.\\end{aligned}\">\\begin{aligned} &amp; \\text{因为} K \\sim U(0,5),\\ \\text{所以} f_{K}(k) = \\begin{cases} 1/5, &amp; 0 &lt; k &lt; 5 \\\\ 0, &amp; \\text{其它} \\end{cases}, \\\\ &amp; \\text{方程} \\ 4x^{2} + 4Kx + K + 2 = 0 \\text{有实根的充要条件为} (4K)^{2} - 4 \\cdot 4(K+2) \\geq 0, \\text{即} \\\\ &amp; \\qquad K^{2} - K - 2 \\geq 0, \\\\ &amp; \\text{亦即} (k-2)(K+1) \\geq 0, \\ \\text{解得} K \\geq 2 (K \\leq -1 \\text{舍去}), \\ \\text{所以} \\\\ &amp; \\qquad P\\{\\text{方程有实根}\\} = P\\{K \\geq 2\\} = \\int_{-\\frac{1}{2}}^{\\frac{1}{2}} \\! \\! dx = \\frac{3}{5}.\\end{aligned}</div>"
