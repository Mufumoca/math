      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{若}X\\sim N(\\mu,\\sigma^2)\\text{，则}\\frac{X-\\mu}{\\sigma}\\sim N(0,1).\\\\&amp;\\text{所以}\\;\\;U=\\frac{\\xi-0.5}{0.5}\\sim N(0,1).\\\\&amp;P\\{\\xi&lt;0\\text{或}\\xi&gt;1\\}\\,=1-P\\{0\\leq\\xi\\leq 1\\}\\,,\\\\&amp;\\text{而}P\\{0\\leq\\xi\\leq 1\\}=P\\{\\frac{0-0.5}{0.5}\\leq\\frac{\\xi-0.5}{0.5}\\leq\\frac{1-0.5}{0.5}\\}=P\\{-1\\leq U\\leq 1\\}=2\\Phi(1)-1\\,.\\\\&amp;P\\{\\xi&lt;0\\text{或}\\xi&gt;1\\}\\,=2[1-\\Phi(1)]=0.3174\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{若}X\\sim N(\\mu,\\sigma^2)\\text{，则}\\frac{X-\\mu}{\\sigma}\\sim N(0,1).\\\\&amp;\\text{所以}\\;\\;U=\\frac{\\xi-0.5}{0.5}\\sim N(0,1).\\\\&amp;P\\{\\xi&lt;0\\text{或}\\xi&gt;1\\}\\,=1-P\\{0\\leq\\xi\\leq 1\\}\\,,\\\\&amp;\\text{而}P\\{0\\leq\\xi\\leq 1\\}=P\\{\\frac{0-0.5}{0.5}\\leq\\frac{\\xi-0.5}{0.5}\\leq\\frac{1-0.5}{0.5}\\}=P\\{-1\\leq U\\leq 1\\}=2\\Phi(1)-1\\,.\\\\&amp;P\\{\\xi&lt;0\\text{或}\\xi&gt;1\\}\\,=2[1-\\Phi(1)]=0.3174\\,.\\end{aligned}</div>"
