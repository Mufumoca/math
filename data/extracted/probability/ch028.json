        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}p_{\\gamma} = P\\{Y \\geq \\mu + 5\\} = 1 - \\Phi(1)\\end{aligned}\">\\begin{aligned}p_{\\gamma} = P\\{Y \\geq \\mu + 5\\} = 1 - \\Phi(1)\\end{aligned}</span>"
