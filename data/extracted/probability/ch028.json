    {
      "id": "q0001",
      "number": 1,
      "header": "#1-Hard",
      "difficulty": "Hard",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{灯泡寿命服从数学期望为}1000 \\text{小时的正态分布，随机抽取}100 \\text{只灯泡中至少有}90 \\text{只灯泡的寿命超过}1000 \\text{小时的概率(列式子即可)}p=(\\cdot).\">\\text{灯泡寿命服从数学期望为}1000 \\text{小时的正态分布，随机抽取}100 \\text{只灯泡中至少有}90 \\text{只灯泡的寿命超过}1000 \\text{小时的概率(列式子即可)}p=(\\cdot).</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\sum_{k=90}^{100} C_{100}^{k} (\\frac{1}{2})^{100}\">\\sum_{k=90}^{100} C_{100}^{k} (\\frac{1}{2})^{100}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\sum_{k=91}^{100} C_{100}^{k} (\\frac{1}{2})^{100}\">\\sum_{k=91}^{100} C_{100}^{k} (\\frac{1}{2})^{100}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\sum_{k=91}^{100} C_{100}^{k}(\\frac{2}{3})^{k}(\\frac{1}{3})^{100-k}\">\\sum_{k=91}^{100} C_{100}^{k}(\\frac{2}{3})^{k}(\\frac{1}{3})^{100-k}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\sum_{k=90}^{100} C_{100}^{k} (\\frac{2}{3})^{k} (\\frac{1}{3})^{100-k}\">\\sum_{k=90}^{100} C_{100}^{k} (\\frac{2}{3})^{k} (\\frac{1}{3})^{100-k}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{设灯泡寿命为 }X,\\text{依题意有} \\\\&amp;\\quad p=\\mathcal{P}\\{X&gt;1000\\}=\\frac{1}{2}\\cdot \\\\&amp;\\text{又设 }100\\text{只灯泡中有 }Y\\text{只灯泡的寿命超过 }1000\\text{小时，则 }Y\\sim B(100,p),\\text{即} \\\\&amp;\\quad P\\{Y=k\\}=C_{100}^{k}p^{k}(1-p)^{100-k}=C_{100}^{k}(\\frac{1}{2})^{100}, \\\\&amp;\\text{所以 }100\\text{只灯泡中至少有 }90\\text{只灯泡的寿命超过 }1000\\text{小时的概率为} \\\\&amp;\\quad P\\{Y\\geq 90\\}=\\sum_{k=90}^{100}P\\{Y=k\\}=\\sum_{k=90}^{100}C_{100}^{k}(\\frac{1}{2})^{100}.\\end{aligned}\">\\begin{aligned}&amp;\\text{设灯泡寿命为 }X,\\text{依题意有} \\\\&amp;\\quad p=\\mathcal{P}\\{X&gt;1000\\}=\\frac{1}{2}\\cdot \\\\&amp;\\text{又设 }100\\text{只灯泡中有 }Y\\text{只灯泡的寿命超过 }1000\\text{小时，则 }Y\\sim B(100,p),\\text{即} \\\\&amp;\\quad P\\{Y=k\\}=C_{100}^{k}p^{k}(1-p)^{100-k}=C_{100}^{k}(\\frac{1}{2})^{100}, \\\\&amp;\\text{所以 }100\\text{只灯泡中至少有 }90\\text{只灯泡的寿命超过 }1000\\text{小时的概率为} \\\\&amp;\\quad P\\{Y\\geq 90\\}=\\sum_{k=90}^{100}P\\{Y=k\\}=\\sum_{k=90}^{100}C_{100}^{k}(\\frac{1}{2})^{100}.\\end{aligned}</div>"
    },
    {
      "id": "q0002",
      "number": 2,
      "header": "#2-Hard",
      "difficulty": "Hard",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}\\begin{array}{l}\\text{设随机变量}\\xi \\text{服从}N(1,0.2^2)，\\text{且已知}\\Phi(2.5)=0.9938，\\ \\Phi(0.5)=0.6915，\\ \\Phi(1.5)=0.9332，\\text{当}x&gt;4\\text{时}，\\\\\\Phi(x)=1，\\text{则}P\\{\\xi_x^2&gt;1.5\\}=(\\ )\\,.\\end{array}\\end{aligned}\">\\begin{aligned}\\begin{array}{l}\\text{设随机变量}\\xi \\text{服从}N(1,0.2^2)，\\text{且已知}\\Phi(2.5)=0.9938，\\ \\Phi(0.5)=0.6915，\\ \\Phi(1.5)=0.9332，\\text{当}x&gt;4\\text{时}，\\\\\\Phi(x)=1，\\text{则}P\\{\\xi_x^2&gt;1.5\\}=(\\ )\\,.\\end{array}\\end{aligned}</div>",
