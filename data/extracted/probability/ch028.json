      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{根据假设} X\\sim N(10.05,0.06^2), \\text{记} a=10.05-0.12,\\, b=10.05+0.12,\\text{则}\\{a\\leq X\\leq b\\} \\text{表示螺栓为合格品.于是,}\\\\ &amp; P\\{a\\leq X\\leq b\\}=P\\{a&lt;X\\leq b\\}=\\Phi\\left(\\frac{b-\\mu}{\\sigma}\\right)-\\Phi\\left(\\frac{a-\\mu}{\\sigma}\\right)\\\\ &amp; \\qquad=\\Phi(2)-\\Phi(-2)=\\Phi(2)-[1-\\Phi(2)]\\ =2\\Phi(2)-1=2\\times 0.9772-1=0.9544\\,,\\\\ &amp; \\text{即螺栓为合格品的概率等于0.9544.}\\end{aligned}\">\\begin{aligned} &amp; \\text{根据假设} X\\sim N(10.05,0.06^2), \\text{记} a=10.05-0.12,\\, b=10.05+0.12,\\text{则}\\{a\\leq X\\leq b\\} \\text{表示螺栓为合格品.于是,}\\\\ &amp; P\\{a\\leq X\\leq b\\}=P\\{a&lt;X\\leq b\\}=\\Phi\\left(\\frac{b-\\mu}{\\sigma}\\right)-\\Phi\\left(\\frac{a-\\mu}{\\sigma}\\right)\\\\ &amp; \\qquad=\\Phi(2)-\\Phi(-2)=\\Phi(2)-[1-\\Phi(2)]\\ =2\\Phi(2)-1=2\\times 0.9772-1=0.9544\\,,\\\\ &amp; \\text{即螺栓为合格品的概率等于0.9544.}\\end{aligned}</div>"
