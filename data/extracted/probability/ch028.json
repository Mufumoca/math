      "header": "#4-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设随机变量}X\\sim N(\\mu,4^{2}),Y\\sim N(\\mu,5^{2}).\\ \\text{记}p_{1}=P\\{X\\leq \\mu-4\\},\\,p_{2}=P\\{Y\\geq \\mu+5\\},\\ \\text{则正确的是( ).}\">\\text{设随机变量}X\\sim N(\\mu,4^{2}),Y\\sim N(\\mu,5^{2}).\\ \\text{记}p_{1}=P\\{X\\leq \\mu-4\\},\\,p_{2}=P\\{Y\\geq \\mu+5\\},\\ \\text{则正确的是( ).}</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}p_1 = P\\{X \\leq \\mu - 4\\} = 1 - \\Phi(0)\\end{aligned}\">\\begin{aligned}p_1 = P\\{X \\leq \\mu - 4\\} = 1 - \\Phi(0)\\end{aligned}</span>"
