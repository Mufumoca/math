      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} (1) \\text{由}\\ \\ &amp; P(A|\\overline{B})+P(\\overline{A}|\\overline{B})=1,\\ \\text{有}\\ P(A|\\overline{B})=P(\\overline{A}|\\overline{B})=0.5\\,,\\ \\text{再根据}\\ A,\\overline{B}\\text{互不相容},\\\\ &amp; P(A|\\overline{B})=\\frac{P(A\\overline{B})}{P(\\overline{B})}=\\frac{P(A)}{1-P(B)}=\\frac{a}{1-a}=0.5\\,,\\\\ \\text{解出}a&amp;=\\frac{1}{3}\\,;\\\\ (2)\\ &amp;P(A\\cup B)=P(A)+P(B)=\\frac{2}{3}\\,.\\end{aligned}\">\\begin{aligned} (1) \\text{由}\\ \\ &amp; P(A|\\overline{B})+P(\\overline{A}|\\overline{B})=1,\\ \\text{有}\\ P(A|\\overline{B})=P(\\overline{A}|\\overline{B})=0.5\\,,\\ \\text{再根据}\\ A,\\overline{B}\\text{互不相容},\\\\ &amp; P(A|\\overline{B})=\\frac{P(A\\overline{B})}{P(\\overline{B})}=\\frac{P(A)}{1-P(B)}=\\frac{a}{1-a}=0.5\\,,\\\\ \\text{解出}a&amp;=\\frac{1}{3}\\,;\\\\ (2)\\ &amp;P(A\\cup B)=P(A)+P(B)=\\frac{2}{3}\\,.\\end{aligned}</div>"
