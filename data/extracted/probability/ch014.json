      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}P(\\overline{A_1\\cup A_2}|B) &amp;= P(\\overline{A_1\\cap A_2}|B) = 1 - P(A_1\\cap A_2|B) \\\\&amp;= 1 - P(\\emptyset|B) = 1 - \\frac{P(\\emptyset\\cap B)}{P(B)} \\\\&amp;= 1 - \\frac{P(\\emptyset)}{P(B)} = 1\\;.\\end{aligned}\">\\begin{aligned}P(\\overline{A_1\\cup A_2}|B) &amp;= P(\\overline{A_1\\cap A_2}|B) = 1 - P(A_1\\cap A_2|B) \\\\&amp;= 1 - P(\\emptyset|B) = 1 - \\frac{P(\\emptyset\\cap B)}{P(B)} \\\\&amp;= 1 - \\frac{P(\\emptyset)}{P(B)} = 1\\;.\\end{aligned}</div>"
