      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设} \\, A_{1}, A_{2}, B \\text{为三个随机事件，且} P(B) &gt; 0 \\, , \\, \\, A_{1} \\cap A_{2} = \\varnothing \\, , \\, \\text{则} \\, P( \\overline{A_{1}} \\cup \\overline{A_{2}} | B) = ( \\, ) \\, .\">\\text{设} \\, A_{1}, A_{2}, B \\text{为三个随机事件，且} P(B) &gt; 0 \\, , \\, \\, A_{1} \\cap A_{2} = \\varnothing \\, , \\, \\text{则} \\, P( \\overline{A_{1}} \\cup \\overline{A_{2}} | B) = ( \\, ) \\, .</span>",
