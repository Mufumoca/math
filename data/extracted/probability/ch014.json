      "header": "#5-Easy",
      "difficulty": "Easy",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设}A,B \\text{为两事件，已知}P(\\overline{A})=0.3,\\ P(B)=0.4,\\ P(A-B)=0.5,\\ \\text{则}P(B|A\\cup \\overline{B})=(\\ ).\">\\text{设}A,B \\text{为两事件，已知}P(\\overline{A})=0.3,\\ P(B)=0.4,\\ P(A-B)=0.5,\\ \\text{则}P(B|A\\cup \\overline{B})=(\\ ).</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 4 }\">\\frac { 1 } { 4 }</span>"
