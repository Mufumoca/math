        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 6 }\">\\frac { 1 } { 6 }</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}P(B|A\\cup \\overline{B})&amp;=\\frac{P(B(A\\cup \\overline{B}))}{P(A\\cup \\overline{B})}=\\frac{P(AB\\cup \\overline{B})}{P(A\\cup \\overline{B})}=\\frac{P(AB)}{P(A\\cup B)}\\\\&amp;=\\frac{P(A)-P(A\\overline{B})}{P(A)+P(B)-P(A\\overline{B})}=\\frac{P(A)-P(A-B)}{P(A)+P(B)-P(A-B)}=\\frac{0.2}{0.8}=\\frac{1}{4}\\,.\\end{aligned}\">\\begin{aligned}P(B|A\\cup \\overline{B})&amp;=\\frac{P(B(A\\cup \\overline{B}))}{P(A\\cup \\overline{B})}=\\frac{P(AB\\cup \\overline{B})}{P(A\\cup \\overline{B})}=\\frac{P(AB)}{P(A\\cup B)}\\\\&amp;=\\frac{P(A)-P(A\\overline{B})}{P(A)+P(B)-P(A\\overline{B})}=\\frac{P(A)-P(A-B)}{P(A)+P(B)-P(A-B)}=\\frac{0.2}{0.8}=\\frac{1}{4}\\,.\\end{aligned}</div>"
