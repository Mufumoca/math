      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由}\\;\\;P(A)=P(AB)+P(A\\overline{B})=0.4\\;,\\;P(AB)=0.2\\;.\\; \\text{因此}\\;P(A\\overline{B})=0.2\\;,\\; \\text{并且}\\;P(B)&gt;0\\;,\\;P(\\overline{B})&gt;0\\;,\\;\\\\&amp;\\text{对于}\\;\\overline{B}\\;,\\; \\text{有}\\;P(A|\\overline{B})+P(\\overline{A}|\\overline{B})=1\\;,\\; \\text{于是}\\;P(A|\\overline{B})=P(A|B)\\;,\\; \\text{因此}\\;A\\text{与}B\\text{相互独立，有}\\;P(B)=\\frac{P(AB)}{P(A)}=0.5\\;,\\;\\\\&amp;\\text{所以}\\;P(A\\cup B)=P(A)+P(B)-P(AB)=0.7\\;.\\end{aligned}\">\\begin{aligned}&amp;\\text{由}\\;\\;P(A)=P(AB)+P(A\\overline{B})=0.4\\;,\\;P(AB)=0.2\\;.\\; \\text{因此}\\;P(A\\overline{B})=0.2\\;,\\; \\text{并且}\\;P(B)&gt;0\\;,\\;P(\\overline{B})&gt;0\\;,\\;\\\\&amp;\\text{对于}\\;\\overline{B}\\;,\\; \\text{有}\\;P(A|\\overline{B})+P(\\overline{A}|\\overline{B})=1\\;,\\; \\text{于是}\\;P(A|\\overline{B})=P(A|B)\\;,\\; \\text{因此}\\;A\\text{与}B\\text{相互独立，有}\\;P(B)=\\frac{P(AB)}{P(A)}=0.5\\;,\\;\\\\&amp;\\text{所以}\\;P(A\\cup B)=P(A)+P(B)-P(AB)=0.7\\;.\\end{aligned}</div>"
