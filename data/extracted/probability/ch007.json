      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{考虑}A,B,C\\text{三者都不发生的逆事件三者至少发生一个即}A\\cup B\\cup C,\\text{由于}ABC\\subset AB,\\text{所以}P(ABC)=0.\\text{根据概率的性质}\\\\ &amp; \\quad P(A\\cup B\\cup C)=P(A)+P(B)+P(C)-P(AB)-P(AC)-P(BC)+P(ABC)\\\\ &amp; \\quad=\\frac{1}{4}+\\frac{1}{4}+\\frac{1}{2}-0-\\frac{1}{8}-\\frac{1}{8}+0=\\frac{3}{4},\\\\ &amp; \\text{所以}\\\\ &amp; \\quad P(\\overline{ABC})=1-P(A\\cup B\\cup C)=\\frac{1}{4}\\,.\\end{aligned}\">\\begin{aligned} &amp; \\text{考虑}A,B,C\\text{三者都不发生的逆事件三者至少发生一个即}A\\cup B\\cup C,\\text{由于}ABC\\subset AB,\\text{所以}P(ABC)=0.\\text{根据概率的性质}\\\\ &amp; \\quad P(A\\cup B\\cup C)=P(A)+P(B)+P(C)-P(AB)-P(AC)-P(BC)+P(ABC)\\\\ &amp; \\quad=\\frac{1}{4}+\\frac{1}{4}+\\frac{1}{2}-0-\\frac{1}{8}-\\frac{1}{8}+0=\\frac{3}{4},\\\\ &amp; \\text{所以}\\\\ &amp; \\quad P(\\overline{ABC})=1-P(A\\cup B\\cup C)=\\frac{1}{4}\\,.\\end{aligned}</div>"
