      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由分布函数的概率计算式}P\\{a&lt;X\\leq \\beta\\}=F(\\beta)-F(\\alpha)\\text{有}\\\\&amp;P\\{c&lt;\\xi\\leq b\\}=F(b)-F(c)=0.1\\,,\\\\&amp;P\\{c&lt;\\xi\\leq d\\}=F(d)-F(c)=0.3\\,,\\\\&amp;P\\{a&lt;\\xi\\leq b\\}=F(b)-F(a)=0.4\\,,\\\\&amp;\\text{则}\\\\&amp;P\\{a&lt;\\xi\\leq d\\}=F(d)-F(a)\\\\&amp;=[F(d)-F(c)]+[F(c)-F(b)]+[F(b)-F(a)]\\\\&amp;=0.3-0.1+0.4=0.6\\end{aligned}\">\\begin{aligned}&amp;\\text{由分布函数的概率计算式}P\\{a&lt;X\\leq \\beta\\}=F(\\beta)-F(\\alpha)\\text{有}\\\\&amp;P\\{c&lt;\\xi\\leq b\\}=F(b)-F(c)=0.1\\,,\\\\&amp;P\\{c&lt;\\xi\\leq d\\}=F(d)-F(c)=0.3\\,,\\\\&amp;P\\{a&lt;\\xi\\leq b\\}=F(b)-F(a)=0.4\\,,\\\\&amp;\\text{则}\\\\&amp;P\\{a&lt;\\xi\\leq d\\}=F(d)-F(a)\\\\&amp;=[F(d)-F(c)]+[F(c)-F(b)]+[F(b)-F(a)]\\\\&amp;=0.3-0.1+0.4=0.6\\end{aligned}</div>"
