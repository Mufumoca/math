      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{由于}\\ \\frac{(n-1)S^2}{\\sigma^2} \\sim \\chi^2(n-1)，\\text{于是}\\\\ P\\{S^2&gt;50\\} &amp;= P\\left\\{\\frac{(n-1)S^2}{\\sigma^2} &gt; \\frac{(n-1)50}{\\sigma^2}\\right\\}\\\\ &amp;= P\\left\\{\\chi^2(24) &gt; \\frac{24 \\times 50}{100}\\right\\} = P\\{\\chi^2(24) &gt; 12\\} &gt; P\\{\\chi^2(24) &gt; 12.401\\}\\\\ &amp;= 0.975 \\end{aligned}\">\\begin{aligned} \\text{由于}\\ \\frac{(n-1)S^2}{\\sigma^2} \\sim \\chi^2(n-1)，\\text{于是}\\\\ P\\{S^2&gt;50\\} &amp;= P\\left\\{\\frac{(n-1)S^2}{\\sigma^2} &gt; \\frac{(n-1)50}{\\sigma^2}\\right\\}\\\\ &amp;= P\\left\\{\\chi^2(24) &gt; \\frac{24 \\times 50}{100}\\right\\} = P\\{\\chi^2(24) &gt; 12\\} &gt; P\\{\\chi^2(24) &gt; 12.401\\}\\\\ &amp;= 0.975 \\end{aligned}</div>"
