      "header": "#1-Averge",
      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{在正态总体}N(\\mu,100)\\text{中取一容量为}n\\text{的样本，其样本均值为}\\overline{X}\\text{，若}P\\{\\mu-5&lt;\\overline{X}&lt;\\mu+5\\}=0.954\\text{，}\\\\ \\text{则}n=(\\cdot)\\ (\\Phi(2)=0.977)\\end{aligned}\">\\begin{aligned} \\text{在正态总体}N(\\mu,100)\\text{中取一容量为}n\\text{的样本，其样本均值为}\\overline{X}\\text{，若}P\\{\\mu-5&lt;\\overline{X}&lt;\\mu+5\\}=0.954\\text{，}\\\\ \\text{则}n=(\\cdot)\\ (\\Phi(2)=0.977)\\end{aligned}</div>",
      "options": [
