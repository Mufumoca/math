      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{设产品生产时间为}X, \\text{则} \\quad&amp; X\\sim N(65,25^2), \\quad \\frac{\\overline{X}-65}{25\\sqrt{n}}\\sim N(0,1), \\\\ \\text{为使}P(|\\overline{X}-65|&lt;15)=0.95, \\text{必须} \\quad&amp; \\frac{\\overline{X}-65}{25\\sqrt{n}}&lt;\\frac{15}{25\\sqrt{n}}\\approx 1.96. \\\\ \\text{所以} \\quad&amp; \\sqrt{n}\\approx 1.96\\times \\frac{5}{3}=3.3, \\text{即}n\\approx 3.2^3=10.89, \\text{取}n=11 \\text{即可}.\\end{aligned}\">\\begin{aligned} \\text{设产品生产时间为}X, \\text{则} \\quad&amp; X\\sim N(65,25^2), \\quad \\frac{\\overline{X}-65}{25\\sqrt{n}}\\sim N(0,1), \\\\ \\text{为使}P(|\\overline{X}-65|&lt;15)=0.95, \\text{必须} \\quad&amp; \\frac{\\overline{X}-65}{25\\sqrt{n}}&lt;\\frac{15}{25\\sqrt{n}}\\approx 1.96. \\\\ \\text{所以} \\quad&amp; \\sqrt{n}\\approx 1.96\\times \\frac{5}{3}=3.3, \\text{即}n\\approx 3.2^3=10.89, \\text{取}n=11 \\text{即可}.\\end{aligned}</div>"
