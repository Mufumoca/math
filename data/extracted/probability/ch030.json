      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{标准正态分布}F(x)\\text{在}x=-t\\,(t&gt;0)\\text{的概率计算为}F(-t)=1-F(t)\\,,\\\\&amp;\\text{故}\\,\\,\\,P\\{-b&lt;\\xi\\leq-a\\}=F(-a)-F(-b)=[1-F(a)]-[1-F(b)]=F(b)-F(a)\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{标准正态分布}F(x)\\text{在}x=-t\\,(t&gt;0)\\text{的概率计算为}F(-t)=1-F(t)\\,,\\\\&amp;\\text{故}\\,\\,\\,P\\{-b&lt;\\xi\\leq-a\\}=F(-a)-F(-b)=[1-F(a)]-[1-F(b)]=F(b)-F(a)\\,.\\end{aligned}</div>"
