      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{标准正态分布在某区间内的概率计算式为}\\\\&amp;P\\{a&lt;X&lt;b\\}=P\\{a\\leq X\\leq b\\}=P\\{a\\leq X&lt;b\\}=P\\{a&lt;X\\leq b\\}=\\Phi(b)-\\Phi(a).\\\\&amp;\\text{故}P\\{0.8&lt;\\xi&lt;2.2\\}=\\Phi(2.2)-\\Phi(0.8)=0.198.\\end{aligned}\">\\begin{aligned}&amp;\\text{标准正态分布在某区间内的概率计算式为}\\\\&amp;P\\{a&lt;X&lt;b\\}=P\\{a\\leq X\\leq b\\}=P\\{a\\leq X&lt;b\\}=P\\{a&lt;X\\leq b\\}=\\Phi(b)-\\Phi(a).\\\\&amp;\\text{故}P\\{0.8&lt;\\xi&lt;2.2\\}=\\Phi(2.2)-\\Phi(0.8)=0.198.\\end{aligned}</div>"
