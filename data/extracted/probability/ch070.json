      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{设组织货源} t \\text{吨，显然应要求} 2000 \\leq t \\leq 4000, \\text{国家收益} Y(\\text{单位：万元})=x \\text{的函数}Y=g(X), \\text{表达式为} \\\\ &amp; \\qquad \\qquad g(X)=\\begin{cases} 3t, &amp; X \\geq t \\\\ 4X-t, &amp; X &lt; t \\end{cases}. \\\\ &amp; \\text{设} X \\text{的概率密度函数为} f(x), \\text{则} \\\\ &amp; \\qquad \\qquad f(x)=\\begin{cases} 1/2000, &amp; 2000 \\leq x \\leq 4000 \\\\ 0, &amp; \\text{其它} \\end{cases}, \\\\ &amp; \\text{于是} Y \\text{的期望为} \\\\ &amp; \\qquad E(Y)=\\int_{2000}^{+\\infty} g(x)f(x)dx=\\int_{2000}^{4000}\\frac{1}{2000}g(x)dx \\\\ &amp; \\qquad=\\frac{1}{2000}\\left[\\int_{2000}^{t}(4x-t)dx+\\int_{t}^{4000}3tdx\\right]=\\frac{1}{2000}(-2t^2+14000t-8\\times 10^6). \\\\ &amp; \\text{考虑} Y \\text{的取值使} E(Y) \\text{达到最大，易得} t=3500, \\text{因此组织} 3500 \\text{吨商品为好}. \\end{aligned}\">\\begin{aligned} &amp; \\text{设组织货源} t \\text{吨，显然应要求} 2000 \\leq t \\leq 4000, \\text{国家收益} Y(\\text{单位：万元})=x \\text{的函数}Y=g(X), \\text{表达式为} \\\\ &amp; \\qquad \\qquad g(X)=\\begin{cases} 3t, &amp; X \\geq t \\\\ 4X-t, &amp; X &lt; t \\end{cases}. \\\\ &amp; \\text{设} X \\text{的概率密度函数为} f(x), \\text{则} \\\\ &amp; \\qquad \\qquad f(x)=\\begin{cases} 1/2000, &amp; 2000 \\leq x \\leq 4000 \\\\ 0, &amp; \\text{其它} \\end{cases}, \\\\ &amp; \\text{于是} Y \\text{的期望为} \\\\ &amp; \\qquad E(Y)=\\int_{2000}^{+\\infty} g(x)f(x)dx=\\int_{2000}^{4000}\\frac{1}{2000}g(x)dx \\\\ &amp; \\qquad=\\frac{1}{2000}\\left[\\int_{2000}^{t}(4x-t)dx+\\int_{t}^{4000}3tdx\\right]=\\frac{1}{2000}(-2t^2+14000t-8\\times 10^6). \\\\ &amp; \\text{考虑} Y \\text{的取值使} E(Y) \\text{达到最大，易得} t=3500, \\text{因此组织} 3500 \\text{吨商品为好}. \\end{aligned}</div>"
