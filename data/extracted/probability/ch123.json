      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp; \\text{先从总体中抽取一容量为 } n \\text{ 的样本 } X_1, X_2, \\cdots, X_n \\text{ 根据中心极限定理，知} \\\\&amp; \\quad U=\\frac{\\overline{X}-\\mu}{\\sigma\\sqrt{n}}\\rightarrow N(0,1)\\quad(n\\rightarrow\\infty).\\\\&amp; (1)\\text{当}\\sigma^2 \\text{已知时，则近似得到}\\mu \\text{ 的置信度为}1-\\alpha \\text{ 的置信区间为} \\\\&amp; \\quad \\left(\\overline{X}-u_{\\sigma^2}\\frac{\\sigma}{\\sqrt{n}},\\overline{X}+u_{\\sigma^2}\\frac{\\sigma}{\\sqrt{n}}\\right).\\\\&amp; (2)\\text{当}\\sigma^2 \\text{未知时，用}\\sigma^2 \\text{的无偏估计}S^2 \\text{代替}\\sigma^2, \\text{这里仍有} \\\\&amp; \\quad \\frac{\\overline{X}-\\mu}{S\\sqrt{n}}\\rightarrow N(0,1)\\quad(n\\rightarrow\\infty), \\\\&amp; \\text{于是得到}\\mu \\text{ 的}1-\\alpha \\text{的置信区间为} \\\\&amp; \\quad \\left(\\overline{X}-u_{\\sigma^2}\\frac{S}{\\sqrt{n}},\\overline{X}+u_{\\sigma^2}\\frac{S}{\\sqrt{n}}\\right), \\\\&amp; \\text{一般要求}n\\geq30 \\text{才能使用上述公式，称为大样本区间估计.}\\end{aligned}\">\\begin{aligned}&amp; \\text{先从总体中抽取一容量为 } n \\text{ 的样本 } X_1, X_2, \\cdots, X_n \\text{ 根据中心极限定理，知} \\\\&amp; \\quad U=\\frac{\\overline{X}-\\mu}{\\sigma\\sqrt{n}}\\rightarrow N(0,1)\\quad(n\\rightarrow\\infty).\\\\&amp; (1)\\text{当}\\sigma^2 \\text{已知时，则近似得到}\\mu \\text{ 的置信度为}1-\\alpha \\text{ 的置信区间为} \\\\&amp; \\quad \\left(\\overline{X}-u_{\\sigma^2}\\frac{\\sigma}{\\sqrt{n}},\\overline{X}+u_{\\sigma^2}\\frac{\\sigma}{\\sqrt{n}}\\right).\\\\&amp; (2)\\text{当}\\sigma^2 \\text{未知时，用}\\sigma^2 \\text{的无偏估计}S^2 \\text{代替}\\sigma^2, \\text{这里仍有} \\\\&amp; \\quad \\frac{\\overline{X}-\\mu}{S\\sqrt{n}}\\rightarrow N(0,1)\\quad(n\\rightarrow\\infty), \\\\&amp; \\text{于是得到}\\mu \\text{ 的}1-\\alpha \\text{的置信区间为} \\\\&amp; \\quad \\left(\\overline{X}-u_{\\sigma^2}\\frac{S}{\\sqrt{n}},\\overline{X}+u_{\\sigma^2}\\frac{S}{\\sqrt{n}}\\right), \\\\&amp; \\text{一般要求}n\\geq30 \\text{才能使用上述公式，称为大样本区间估计.}\\end{aligned}</div>"
