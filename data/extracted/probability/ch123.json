      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}\\text{这是}(0-1)\\text{分布参数的区间估计问题，待业率}p\\text{的}0.95\\text{置信区间为}\\\\widehat{p_{1}},\\widehat{p_{2}})=\\left(\\frac{-b-\\sqrt{b^{2}-4ac}}{2a},\\frac{-b+\\sqrt{b^{2}-4ac}}{2a}\\right).\\\\\\text{其中}\\\\a=n+u_{n2}^{2},\\,b=-2n\\overline{X}-(u_{n2})^{2},\\,\\,\\,c=n\\overline{X},\\\\n=500,\\,\\overline{x}=\\frac{13}{500},\\,u_{n2}=1.96.\\end{aligned}\">\\begin{aligned}\\text{这是}(0-1)\\text{分布参数的区间估计问题，待业率}p\\text{的}0.95\\text{置信区间为}\\\\widehat{p_{1}},\\widehat{p_{2}})=\\left(\\frac{-b-\\sqrt{b^{2}-4ac}}{2a},\\frac{-b+\\sqrt{b^{2}-4ac}}{2a}\\right).\\\\\\text{其中}\\\\a=n+u_{n2}^{2},\\,b=-2n\\overline{X}-(u_{n2})^{2},\\,\\,\\,c=n\\overline{X},\\\\n=500,\\,\\overline{x}=\\frac{13}{500},\\,u_{n2}=1.96.\\end{aligned}</div>"
