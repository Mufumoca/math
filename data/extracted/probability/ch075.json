      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{因为 }E[(X+2Y)^2]=E(X^2)+4E(XY)+4E(Y^2)\\,,\\\\&amp;\\text{又因 }X,Y\\text{独立，有 }E(XY)=E(X)E(Y)=0\\,,\\\\&amp;\\text{因为 }E(X^2)=D(X)+E^2(X)=1\\,,\\,\\,\\,E(Y^2)=D(Y)+E^2(Y)=1\\,,\\\\&amp;\\text{故 }E[(X+2Y)^2]=5\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{因为 }E[(X+2Y)^2]=E(X^2)+4E(XY)+4E(Y^2)\\,,\\\\&amp;\\text{又因 }X,Y\\text{独立，有 }E(XY)=E(X)E(Y)=0\\,,\\\\&amp;\\text{因为 }E(X^2)=D(X)+E^2(X)=1\\,,\\,\\,\\,E(Y^2)=D(Y)+E^2(Y)=1\\,,\\\\&amp;\\text{故 }E[(X+2Y)^2]=5\\,.\\end{aligned}</div>"
    },
    {
      "id": "q0002",
      "number": 2,
      "header": "#2-Averge",
      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text{设}X \\text{为一随机变量，}E(X) = \\mu , D(X) = \\sigma ^{2} (\\sigma &gt; 0), \\text{则对于任意常数}c, \\text{必有( )成立。} \\end{array}\">\\begin{array}{l} \\text{设}X \\text{为一随机变量，}E(X) = \\mu , D(X) = \\sigma ^{2} (\\sigma &gt; 0), \\text{则对于任意常数}c, \\text{必有( )成立。} \\end{array}</div>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}E^2(X-c) \\geq E(X-\\mu)\\end{aligned}\">\\begin{aligned}E^2(X-c) \\geq E(X-\\mu)\\end{aligned}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}E^2(X-c)=E(X^2)-c^2\\end{aligned}\">\\begin{aligned}E^2(X-c)=E(X^2)-c^2\\end{aligned}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}E^2(X-c)=E(X-\\mu^2)\\end{aligned}\">\\begin{aligned}E^2(X-c)=E(X-\\mu^2)\\end{aligned}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"E^{2}(X-c) &lt; E(X-\\mu)\">E^{2}(X-c) &lt; E(X-\\mu)</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;E^2(X-c)=(\\mu-c)^2\\,,\\,\\,\\,E(X-\\mu)=E(X)-\\mu=0\\,,\\\\&amp;\\text{显然有}E^2(X-c)\\geq E(X-\\mu)\\,.\\end{aligned}\">\\begin{aligned}&amp;E^2(X-c)=(\\mu-c)^2\\,,\\,\\,\\,E(X-\\mu)=E(X)-\\mu=0\\,,\\\\&amp;\\text{显然有}E^2(X-c)\\geq E(X-\\mu)\\,.\\end{aligned}</div>"
    },
