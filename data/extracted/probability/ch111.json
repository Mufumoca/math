      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设总体}X\\sim N(0,1),X_{1},X_{2},\\cdots,X_{n}\\text{为样本，则下列结论中错误的是( )}.\">\\text{设总体}X\\sim N(0,1),X_{1},X_{2},\\cdots,X_{n}\\text{为样本，则下列结论中错误的是( )}.</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{X_{1}+X_{2}}{\\sqrt{X_{1}^{2}+X_{2}^{2}}}\\sim t(2)\">\\frac{X_{1}+X_{2}}{\\sqrt{X_{1}^{2}+X_{2}^{2}}}\\sim t(2)</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}\\frac{X_1-X_2}{\\left(X_3^2+X_4^2\\right)^{\\frac{1}{2}}}\\sim t(2)\\end{aligned}\">\\begin{aligned}\\frac{X_1-X_2}{\\left(X_3^2+X_4^2\\right)^{\\frac{1}{2}}}\\sim t(2)\\end{aligned}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}\\frac{\\sqrt{n-1}X_{1}}{\\sqrt{\\sum_{i=2}^{n}X_{i}^{2}}}\\sim t(n-1)\\end{aligned}\">\\begin{aligned}\\frac{\\sqrt{n-1}X_{1}}{\\sqrt{\\sum_{i=2}^{n}X_{i}^{2}}}\\sim t(n-1)\\end{aligned}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}\\frac{(\\frac{n}{3}-1)\\sum_{i=1}^{3}X_{i}^{2}}{\\sum_{i=4}^{n}X_{i}^{2}}\\sim F(3,n-3)\\end{aligned}\">\\begin{aligned}\\frac{(\\frac{n}{3}-1)\\sum_{i=1}^{3}X_{i}^{2}}{\\sum_{i=4}^{n}X_{i}^{2}}\\sim F(3,n-3)\\end{aligned}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{若}X\\sim N(0,1),\\ Y\\sim \\chi^{2}(n),\\ \\text{且}\\ \\lambda\\text{与}Y\\text{相互独立，则}t\\sim t(n),\\ \\text{其中}t=\\frac{X}{\\sqrt{Y/n}};\\\\&amp;\\text{若}X\\sim \\chi^{2}(m),\\ Y\\sim \\chi^{2}(n),\\ \\text{且}\\ \\lambda\\text{与}Y\\text{相互独立，则}F\\sim F(m,n),\\ \\text{其中}F=\\frac{X/m}{Y/n}=\\frac{nX}{mY}.\\\\&amp;\\text{可见，不管是}t\\text{分布还是}F\\text{分布都要求分子分母是独立的。而}\\frac{X_{1}+X_{2}}{\\sqrt{X_{1}^{2}+X_{2}^{2}}}\\text{不满足}.\\end{aligned}\">\\begin{aligned}&amp;\\text{若}X\\sim N(0,1),\\ Y\\sim \\chi^{2}(n),\\ \\text{且}\\ \\lambda\\text{与}Y\\text{相互独立，则}t\\sim t(n),\\ \\text{其中}t=\\frac{X}{\\sqrt{Y/n}};\\\\&amp;\\text{若}X\\sim \\chi^{2}(m),\\ Y\\sim \\chi^{2}(n),\\ \\text{且}\\ \\lambda\\text{与}Y\\text{相互独立，则}F\\sim F(m,n),\\ \\text{其中}F=\\frac{X/m}{Y/n}=\\frac{nX}{mY}.\\\\&amp;\\text{可见，不管是}t\\text{分布还是}F\\text{分布都要求分子分母是独立的。而}\\frac{X_{1}+X_{2}}{\\sqrt{X_{1}^{2}+X_{2}^{2}}}\\text{不满足}.\\end{aligned}</div>"
    },
    {
      "id": "q0002",
      "number": 2,
      "header": "#2-Averge",
      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {设} X \\sim N(0, 16), \\ Y \\sim N(0, 9), \\ X, Y \\text {相互独立}, \\ X_{1}, X_{2}, \\cdots, X_{n} \\text {与} Y_{1}, Y_{2}, \\cdots, Y_{16} \\text {分布为} x \\text {与} Y \\text {的一个简单随机样本，} \\\\ \\text {则} \\quad \\frac{X_{1}^{2} + X_{2}^{2} + \\cdots + X_{n}^{2}}{Y_{1}^{2} + Y_{2}^{2} + \\cdots + Y_{16}^{2}} \\text {服从的分布为} (\\text {.}). \\end{array}\">\\begin{array}{l} \\text {设} X \\sim N(0, 16), \\ Y \\sim N(0, 9), \\ X, Y \\text {相互独立}, \\ X_{1}, X_{2}, \\cdots, X_{n} \\text {与} Y_{1}, Y_{2}, \\cdots, Y_{16} \\text {分布为} x \\text {与} Y \\text {的一个简单随机样本，} \\\\ \\text {则} \\quad \\frac{X_{1}^{2} + X_{2}^{2} + \\cdots + X_{n}^{2}}{Y_{1}^{2} + Y_{2}^{2} + \\cdots + Y_{16}^{2}} \\text {服从的分布为} (\\text {.}). \\end{array}</div>",
