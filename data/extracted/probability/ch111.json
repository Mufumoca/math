      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {设总体} \\lambda \\text {和} \\gamma \\text {相互独立，分别服从} N(0,\\frac{1}{n}) \\text {和} N(0,\\frac{1}{m}), \\text { } n \\text { 和 } m \\text { 是自然数，且 } n \\neq m . \\quad X_{1}, X_{2}, \\cdots, X_{k} \\text { 和} \\\\ Y_{1}, Y_{2}, \\cdots, Y_{l} \\text { 分别是 } \\lambda \\text { 和 } \\gamma \\text { 的样本，要使 } \\frac{X_{1} + X_{2} + \\cdots + X_{k}}{\\sqrt{Y_{1}^{2} + Y_{2}^{2} + \\cdots + Y_{l}^{2}}} \\text { 服从 } t \\text { 分布，} k,l \\text { 应满足条件（）. } \\end{array}\">\\begin{array}{l} \\text {设总体} \\lambda \\text {和} \\gamma \\text {相互独立，分别服从} N(0,\\frac{1}{n}) \\text {和} N(0,\\frac{1}{m}), \\text { } n \\text { 和 } m \\text { 是自然数，且 } n \\neq m . \\quad X_{1}, X_{2}, \\cdots, X_{k} \\text { 和} \\\\ Y_{1}, Y_{2}, \\cdots, Y_{l} \\text { 分别是 } \\lambda \\text { 和 } \\gamma \\text { 的样本，要使 } \\frac{X_{1} + X_{2} + \\cdots + X_{k}}{\\sqrt{Y_{1}^{2} + Y_{2}^{2} + \\cdots + Y_{l}^{2}}} \\text { 服从 } t \\text { 分布，} k,l \\text { 应满足条件（）. } \\end{array}</div>",
