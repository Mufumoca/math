      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由}X_{i}\\sim N(0,\\frac{1}{n})\\Rightarrow \\sum_{i=1}^{k}X_{i}\\sim N(0,\\frac{k}{n})\\ \\Rightarrow\\ \\frac{\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\frac{k}{n}}}\\sim N(0,1).\\\\&amp;\\text{另一方面，由}Y_{i}\\sim N(0,\\frac{1}{m})\\ \\Rightarrow\\ \\frac{Y_{i}}{\\sqrt{\\frac{1}{m}}}\\sim N(0,1)\\ \\Rightarrow\\ \\frac{Y_{i}^{2}}{\\frac{1}{m}}\\sim\\chi^{2}(1)\\ \\Rightarrow\\ \\sum_{i=1}^{l}\\frac{Y_{i}^{2}}{\\frac{1}{m}}=m\\sum_{l=1}^{l}Y_{i}^{2}\\sim\\chi^{2}(l)\\\\&amp;\\text{从而}T=\\frac{\\sqrt{\\frac{n}{k}}\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\frac{m}{l}}\\sum_{l=1}^{l}Y_{i}^{2}}\\sim t(l)\\text{，因此若要}\\frac{\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\sum_{i=1}^{l}Y_{i}^{2}}}\\sim t(l)\\text{，则应有}\\sqrt{\\frac{n}{k}}=\\sqrt{\\frac{m}{l}}\\text{，即}\\ \\frac{k}{l}=\\frac{n}{m}\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{由}X_{i}\\sim N(0,\\frac{1}{n})\\Rightarrow \\sum_{i=1}^{k}X_{i}\\sim N(0,\\frac{k}{n})\\ \\Rightarrow\\ \\frac{\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\frac{k}{n}}}\\sim N(0,1).\\\\&amp;\\text{另一方面，由}Y_{i}\\sim N(0,\\frac{1}{m})\\ \\Rightarrow\\ \\frac{Y_{i}}{\\sqrt{\\frac{1}{m}}}\\sim N(0,1)\\ \\Rightarrow\\ \\frac{Y_{i}^{2}}{\\frac{1}{m}}\\sim\\chi^{2}(1)\\ \\Rightarrow\\ \\sum_{i=1}^{l}\\frac{Y_{i}^{2}}{\\frac{1}{m}}=m\\sum_{l=1}^{l}Y_{i}^{2}\\sim\\chi^{2}(l)\\\\&amp;\\text{从而}T=\\frac{\\sqrt{\\frac{n}{k}}\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\frac{m}{l}}\\sum_{l=1}^{l}Y_{i}^{2}}\\sim t(l)\\text{，因此若要}\\frac{\\sum_{i=1}^{k}X_{i}}{\\sqrt{\\sum_{i=1}^{l}Y_{i}^{2}}}\\sim t(l)\\text{，则应有}\\sqrt{\\frac{n}{k}}=\\sqrt{\\frac{m}{l}}\\text{，即}\\ \\frac{k}{l}=\\frac{n}{m}\\,.\\end{aligned}</div>"
