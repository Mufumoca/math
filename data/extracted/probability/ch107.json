      "difficulty": "Hard",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l}\n\\begin{array}{|c|c|c|c|c|c|c|c|c|} \\hline \\text{月人均收入}(\\text{百元}) &amp; 5-6 &amp; 6-7 &amp; 7-8 &amp; 8-9 &amp; 9-10 &amp; 10-11 &amp; 11-12 &amp; \\text{合计} \\\\ \\hline \\text{户数} &amp; 18 &amp; 35 &amp; 76 &amp; 24 &amp; 19 &amp; 14 &amp; 14 &amp; 200 \\\\ \\hline \\end{array}\n\\text{则样本方差} s^{2} \\text{为}（）。\n\n\\end{array}\">\\begin{array}{l}\n\\begin{array}{|c|c|c|c|c|c|c|c|c|} \\hline \\text{月人均收入}(\\text{百元}) &amp; 5-6 &amp; 6-7 &amp; 7-8 &amp; 8-9 &amp; 9-10 &amp; 10-11 &amp; 11-12 &amp; \\text{合计} \\\\ \\hline \\text{户数} &amp; 18 &amp; 35 &amp; 76 &amp; 24 &amp; 19 &amp; 14 &amp; 14 &amp; 200 \\\\ \\hline \\end{array}\n\\text{则样本方差} s^{2} \\text{为}（）。\n\n\\end{array}</div>",
      "options": [
