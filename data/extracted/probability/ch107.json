      "header": "#2-Easy",
      "difficulty": "Easy",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{已知总体}X \\text{服从}[0,\\lambda]\\text{上的均匀分布}(\\lambda \\text{未知}),\\ X_{1},X_{2},\\cdots,X_{n}\\text{为}X\\text{的样本，则}( ).\">\\text{已知总体}X \\text{服从}[0,\\lambda]\\text{上的均匀分布}(\\lambda \\text{未知}),\\ X_{1},X_{2},\\cdots,X_{n}\\text{为}X\\text{的样本，则}( ).</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} { r } { X _ { 1 } + X _ { 2 } \\text{是} \\text{一个} \\text{统} \\text{计} \\text{量} } \\end{array}\">\\begin{array}{l} { r } { X _ { 1 } + X _ { 2 } \\text{是} \\text{一个} \\text{统} \\text{计} \\text{量} } \\end{array}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{n} \\sum_{i=1}^{n} X_{i} - \\frac{\\lambda}{2} \\text{是一个统计量}\">\\frac{1}{n} \\sum_{i=1}^{n} X_{i} - \\frac{\\lambda}{2} \\text{是一个统计量}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{n} \\sum_{i=1}^{n} X_{i} - E(X) \\text{是一个统计量}\">\\frac{1}{n} \\sum_{i=1}^{n} X_{i} - E(X) \\text{是一个统计量}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{n}\\sum_{i=1}^{n}X_{i}^{2}-D(X) \\text{是一个统计量}\">\\frac{1}{n}\\sum_{i=1}^{n}X_{i}^{2}-D(X) \\text{是一个统计量}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {统计量是不能包含总体的未知参数} \\lambda \\text {的，又均匀总体中均值} E(X) \\text {与方差} D(X) \\text {都是含有总体的未知参数} \\lambda , \\text {故统计量要排除这些项}. \\end{array}\">\\begin{array}{l} \\text {统计量是不能包含总体的未知参数} \\lambda \\text {的，又均匀总体中均值} E(X) \\text {与方差} D(X) \\text {都是含有总体的未知参数} \\lambda , \\text {故统计量要排除这些项}. \\end{array}</div>"
    },
    {
      "id": "q0003",
      "number": 3,
      "header": "#3-Hard",
      "difficulty": "Hard",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {设} X_{1}, \\cdots, X_{n} \\text {为总体} \\lambda \\text {的一个样本，} x_{1}, \\cdots, x_{n} \\text {为样本的一组观察值．将此观察值按由小至大顺序排列：} \\\\ x_{1}^{*} \\leq x_{2}^{*} \\leq \\cdots \\leq x_{n}^{*}, \\text {若} (X_{1}^{*}, X_{2}^{*}, \\cdots, X_{n}^{*}) \\text {的取值为} (x_{1}^{*}, x_{2}^{*}, \\cdots, x_{n}^{*}) , \\text {则称（）为顺序统计量.} \\end{array}\">\\begin{array}{l} \\text {设} X_{1}, \\cdots, X_{n} \\text {为总体} \\lambda \\text {的一个样本，} x_{1}, \\cdots, x_{n} \\text {为样本的一组观察值．将此观察值按由小至大顺序排列：} \\\\ x_{1}^{*} \\leq x_{2}^{*} \\leq \\cdots \\leq x_{n}^{*}, \\text {若} (X_{1}^{*}, X_{2}^{*}, \\cdots, X_{n}^{*}) \\text {的取值为} (x_{1}^{*}, x_{2}^{*}, \\cdots, x_{n}^{*}) , \\text {则称（）为顺序统计量.} \\end{array}</div>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\vec{X_{i}}(i=1,2,\\cdots,n)\">\\vec{X_{i}}(i=1,2,\\cdots,n)</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\mathit{Min}(X_{1},\\cdots,X_{n}){\\overset{\\rightarrow}{=}}X_{1}^{\\prime}\">\\mathit{Min}(X_{1},\\cdots,X_{n}){\\overset{\\rightarrow}{=}}X_{1}^{\\prime}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\mathit{Max}(X_{1},\\cdots X_{n}) = X_{n}^{\\ast}\">\\mathit{Max}(X_{1},\\cdots X_{n}) = X_{n}^{\\ast}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{aligned}\\widetilde{X} = \\{ \\begin{array}{c} X_{i+1}^{\\ast}, \\ 2i+1=n \\\\ \\\\ (X_{i}^{\\ast}+X_{i+1}^{\\ast})/2, \\ 2i=n \\end{array}\\end{aligned}\">\\begin{aligned}\\widetilde{X} = \\{ \\begin{array}{c} X_{i+1}^{\\ast}, \\ 2i+1=n \\\\ \\\\ (X_{i}^{\\ast}+X_{i+1}^{\\ast})/2, \\ 2i=n \\end{array}\\end{aligned}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{根据定义，}X_{i}^{*}(i=1,2,\\cdots,n)\\text{称为顺序统计量；}\\\\&amp;\\quad Min(X_{1},\\cdots,X_{n})=X_{1}^{*}\\text{称为极小统计量；}\\\\&amp;\\quad Max(X_{1},\\cdots X_{n})=X_{n}^{*}\\text{称为极大统计量；}\\\\&amp;\\quad \\widetilde{X}=\\begin{cases}X_{i+1},\\ 2i+1=n\\\\ (X_{i}^{*}+X_{i+1}^{*})/2,\\ 2i=n\\end{cases}\\text{称为中位数（统计量），且是总体均值的无偏估计.}\\end{aligned}\">\\begin{aligned}&amp;\\text{根据定义，}X_{i}^{*}(i=1,2,\\cdots,n)\\text{称为顺序统计量；}\\\\&amp;\\quad Min(X_{1},\\cdots,X_{n})=X_{1}^{*}\\text{称为极小统计量；}\\\\&amp;\\quad Max(X_{1},\\cdots X_{n})=X_{n}^{*}\\text{称为极大统计量；}\\\\&amp;\\quad \\widetilde{X}=\\begin{cases}X_{i+1},\\ 2i+1=n\\\\ (X_{i}^{*}+X_{i+1}^{*})/2,\\ 2i=n\\end{cases}\\text{称为中位数（统计量），且是总体均值的无偏估计.}\\end{aligned}</div>"
