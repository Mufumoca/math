      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{设}X,Y\\text{的概率密度为} \\\\f(x,y)=\\begin{cases} 1, \\ |y|\\leq x, \\ 0\\leq x\\leq 1 \\\\ 0, \\quad\\quad\\text{其它} \\end{cases}, \\\\ \\text{则不正确的是( ).} \\end{aligned}\">\\begin{aligned} \\text{设}X,Y\\text{的概率密度为} \\\\f(x,y)=\\begin{cases} 1, \\ |y|\\leq x, \\ 0\\leq x\\leq 1 \\\\ 0, \\quad\\quad\\text{其它} \\end{cases}, \\\\ \\text{则不正确的是( ).} \\end{aligned}</div>",
