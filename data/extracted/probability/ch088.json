      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{因为 } f_{\\lambda}(x) &amp; = \\{ \\begin{array}{ll} 1, &amp; 0 &lt; x &lt; 1 \\\\ 0, &amp; \\text{其它} \\end{array}, \\quad f_{\\gamma}(y) = \\{ \\begin{array}{ll} 1/2, &amp; 1 &lt; y &lt; 3 \\\\ 0, &amp; \\text{其它} \\end{array}, \\text{所以} \\\\ &amp; f(x,y) = \\{ \\begin{array}{ll} 1/2, &amp; 0 &lt; x &lt; 1, \\, 1 &lt; y &lt; 3 \\\\ 0, &amp; \\text{其它} \\end{array}, \\\\ \\text{则} \\\\ E(XY) &amp; = \\int_{0}^{1} x dx \\int_{1}^{1} \\frac{1}{2} y dy = \\frac{1}{2} \\times 2 = 1, \\quad E(X^{2}Y^{2}) = \\int_{0}^{1} x^{2} dx \\int_{1}^{1} \\frac{1}{2} y^{2} dy = \\frac{1}{3} \\times \\frac{13}{3} = \\frac{13}{9}, \\\\ \\text{故 } D(XY) &amp; = E(X^{2}Y^{2}) - [E(XY)]^{2} = \\frac{13}{9} - 1 = \\frac{4}{9}. \\end{aligned}\">\\begin{aligned} \\text{因为 } f_{\\lambda}(x) &amp; = \\{ \\begin{array}{ll} 1, &amp; 0 &lt; x &lt; 1 \\\\ 0, &amp; \\text{其它} \\end{array}, \\quad f_{\\gamma}(y) = \\{ \\begin{array}{ll} 1/2, &amp; 1 &lt; y &lt; 3 \\\\ 0, &amp; \\text{其它} \\end{array}, \\text{所以} \\\\ &amp; f(x,y) = \\{ \\begin{array}{ll} 1/2, &amp; 0 &lt; x &lt; 1, \\, 1 &lt; y &lt; 3 \\\\ 0, &amp; \\text{其它} \\end{array}, \\\\ \\text{则} \\\\ E(XY) &amp; = \\int_{0}^{1} x dx \\int_{1}^{1} \\frac{1}{2} y dy = \\frac{1}{2} \\times 2 = 1, \\quad E(X^{2}Y^{2}) = \\int_{0}^{1} x^{2} dx \\int_{1}^{1} \\frac{1}{2} y^{2} dy = \\frac{1}{3} \\times \\frac{13}{3} = \\frac{13}{9}, \\\\ \\text{故 } D(XY) &amp; = E(X^{2}Y^{2}) - [E(XY)]^{2} = \\frac{13}{9} - 1 = \\frac{4}{9}. \\end{aligned}</div>"
