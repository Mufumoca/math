      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{由于} \\; X \\text{ 服从} \\lambda=1 \\text{ 的指数分布，因此} \\; E(X)=1, D(X)=1 \\; , \\; E(X^2)=D(X)+(E(X))^2=2. \\\\ \\\\ E(X+e^{-2X})=E(X)+E(e^{-2X})=1+\\int_0^{+\\infty}e^{-2x}e^{-x}dx=1+\\frac{1}{3}\\int_0^{+\\infty}e^{-3x}dx=1+\\frac{1}{3}=\\frac{4}{3}\\; . \\\\ \\text{另由} \\; (X+e^{-2X})^2=X^2+2Xe^{-2X}+e^{-4X}\\; , \\; \\text{且} \\\\ \\\\ E(Xe^{-2X})=\\int_0^{+\\infty}xe^{-2x}e^{-x}dx=\\int_0^{+\\infty}xe^{-3x}dx=\\frac{1}{3}\\int_0^{+\\infty}3xe^{-3x}dx=\\frac{1}{3}\\times\\frac{1}{3}=\\frac{1}{9}\\; , \\\\ \\\\ E(e^{-4X})=\\int_0^{+\\infty}e^{-4x}e^{-x}dx=\\frac{1}{5}\\int_0^{+\\infty}5e^{-5x}dx=\\frac{1}{5}\\; , \\\\ \\text{得} \\; \\\\ E[(X+e^{-2X})^2]=E(X^2)+2E(Xe^{-2X})+E(e^{-4X})=2+2\\times\\frac{1}{9}+\\frac{1}{5}=\\frac{109}{45}\\; . \\\\ \\text{所以} \\; D(X+e^{-2X})=\\frac{109}{45}-\\frac{16}{9}=\\frac{29}{45}\\; . \\end{aligned}\">\\begin{aligned} \\text{由于} \\; X \\text{ 服从} \\lambda=1 \\text{ 的指数分布，因此} \\; E(X)=1, D(X)=1 \\; , \\; E(X^2)=D(X)+(E(X))^2=2. \\\\ \\\\ E(X+e^{-2X})=E(X)+E(e^{-2X})=1+\\int_0^{+\\infty}e^{-2x}e^{-x}dx=1+\\frac{1}{3}\\int_0^{+\\infty}e^{-3x}dx=1+\\frac{1}{3}=\\frac{4}{3}\\; . \\\\ \\text{另由} \\; (X+e^{-2X})^2=X^2+2Xe^{-2X}+e^{-4X}\\; , \\; \\text{且} \\\\ \\\\ E(Xe^{-2X})=\\int_0^{+\\infty}xe^{-2x}e^{-x}dx=\\int_0^{+\\infty}xe^{-3x}dx=\\frac{1}{3}\\int_0^{+\\infty}3xe^{-3x}dx=\\frac{1}{3}\\times\\frac{1}{3}=\\frac{1}{9}\\; , \\\\ \\\\ E(e^{-4X})=\\int_0^{+\\infty}e^{-4x}e^{-x}dx=\\frac{1}{5}\\int_0^{+\\infty}5e^{-5x}dx=\\frac{1}{5}\\; , \\\\ \\text{得} \\; \\\\ E[(X+e^{-2X})^2]=E(X^2)+2E(Xe^{-2X})+E(e^{-4X})=2+2\\times\\frac{1}{9}+\\frac{1}{5}=\\frac{109}{45}\\; . \\\\ \\text{所以} \\; D(X+e^{-2X})=\\frac{109}{45}-\\frac{16}{9}=\\frac{29}{45}\\; . \\end{aligned}</div>"
