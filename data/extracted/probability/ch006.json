        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} r - p \\, , \\; \\; 1 - r \\, , \\; \\; 1 + r - p - q \\, , \\; \\; 1 + p - r \\end{array}\">\\begin{array}{l} r - p \\, , \\; \\; 1 - r \\, , \\; \\; 1 + r - p - q \\, , \\; \\; 1 + p - r \\end{array}</span>"
