      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}P(AB) &amp;= P(\\overline{AB}) = P(\\overline{A\\cup B}) = 1 - P(A\\cup B) \\\\&amp;= 1 - P(A) - P(B) + P(AB)\\,, \\end{aligned} \\text{所以} P(A) + P(B) = 1，\\text{将} P(A) = 0.6 \\text{代入}，\\text{得} P(B) = 1 - P(A) = 0.4．\">\\begin{aligned}P(AB) &amp;= P(\\overline{AB}) = P(\\overline{A\\cup B}) = 1 - P(A\\cup B) \\\\&amp;= 1 - P(A) - P(B) + P(AB)\\,, \\end{aligned} \\text{所以} P(A) + P(B) = 1，\\text{将} P(A) = 0.6 \\text{代入}，\\text{得} P(B) = 1 - P(A) = 0.4．</div>"
