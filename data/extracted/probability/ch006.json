        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{l} r - q \\, , \\; \\; 1 - r \\, , \\; \\; 1 + r - p - q \\, , \\; \\; 1 + q - r \\end{array}\">\\begin{array}{l} r - q \\, , \\; \\; 1 - r \\, , \\; \\; 1 + r - p - q \\, , \\; \\; 1 + q - r \\end{array}</span>"
