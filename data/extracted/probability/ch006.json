      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{根据对偶律}\\overline{AB}=\\overline{A\\cup B}\\, ,\\,\\text{则}\\\\&amp;P(\\overline{AB})=1-P(A\\cup B)=1-[P(A)+P(B)-P(AB)]=0.5\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{根据对偶律}\\overline{AB}=\\overline{A\\cup B}\\, ,\\,\\text{则}\\\\&amp;P(\\overline{AB})=1-P(A\\cup B)=1-[P(A)+P(B)-P(AB)]=0.5\\,.\\end{aligned}</div>"
