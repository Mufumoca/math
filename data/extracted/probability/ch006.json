    {
      "id": "q0022",
      "number": 22,
      "header": "#22-Easy",
      "difficulty": "Easy",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{设 } A,B\\ \\text{互不相容，且}\\ \\ P(A)=p,\\ P(B)=q,\\ \\text{则} \\ P\\Bigl( (\\overline{A}\\cup B)\\cap (A\\cup \\overline{B})\\Bigr)=\\left(\\ \\right).\">\\text{设 } A,B\\ \\text{互不相容，且}\\ \\ P(A)=p,\\ P(B)=q,\\ \\text{则} \\ P\\Bigl( (\\overline{A}\\cup B)\\cap (A\\cup \\overline{B})\\Bigr)=\\left(\\ \\right).</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"1 - (p + q)\">1 - (p + q)</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\, p + q - p q \\,\">\\, p + q - p q \\,</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"1 - q\">1 - q</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"1 \\! - \\! p\">1 \\! - \\! p</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{先化简}(\\overline{A\\cup B})\\cap (A\\cup \\overline{B})\\;,\\; \\text{有} \\\\&amp;\\quad(\\overline{A\\cup B})\\cap (A\\cup \\overline{B})=\\overline{A\\cdot B}\\cup AB\\,,\\\\&amp;\\text{于是}P((\\overline{A\\cup B})\\cap (A\\cup \\overline{B}))=P\\Bigl(\\overline{A\\cdot B}\\cup AB\\Bigr)\\\\&amp;\\qquad=P(\\overline{A\\cdot B})+P(AB)-P(\\overline{A\\cdot B}AB)\\\\&amp;\\qquad=P(\\overline{A\\cup B})+0-0=1-P(A\\cup B)\\\\&amp;\\qquad=1-[P(A)+P(B)-P(AB)]\\\\&amp;\\qquad=1-(p+q-0)=1-(p+q)\\,.\\end{aligned}\">\\begin{aligned}&amp;\\text{先化简}(\\overline{A\\cup B})\\cap (A\\cup \\overline{B})\\;,\\; \\text{有} \\\\&amp;\\quad(\\overline{A\\cup B})\\cap (A\\cup \\overline{B})=\\overline{A\\cdot B}\\cup AB\\,,\\\\&amp;\\text{于是}P((\\overline{A\\cup B})\\cap (A\\cup \\overline{B}))=P\\Bigl(\\overline{A\\cdot B}\\cup AB\\Bigr)\\\\&amp;\\qquad=P(\\overline{A\\cdot B})+P(AB)-P(\\overline{A\\cdot B}AB)\\\\&amp;\\qquad=P(\\overline{A\\cup B})+0-0=1-P(A\\cup B)\\\\&amp;\\qquad=1-[P(A)+P(B)-P(AB)]\\\\&amp;\\qquad=1-(p+q-0)=1-(p+q)\\,.\\end{aligned}</div>"
