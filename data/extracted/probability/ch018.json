    {
      "id": "q0005",
      "number": 5,
      "header": "#5-Easy",
      "difficulty": "Easy",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {设两个相互独立的事件} A \\text {和} B \\text {都不发生的概率为} \\frac{1}{9},A \\text {发生} B \\text {不发生的概率与} B \\text {发生} A \\text {不发生的概率相等，则} \\\\ P(A) = () . \\end{array}\">\\begin{array}{l} \\text {设两个相互独立的事件} A \\text {和} B \\text {都不发生的概率为} \\frac{1}{9},A \\text {发生} B \\text {不发生的概率与} B \\text {发生} A \\text {不发生的概率相等，则} \\\\ P(A) = () . \\end{array}</div>",
