      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp; \\text{由事件}A,B \\text{独立} \\Rightarrow \\overline{A}, \\overline{B} \\text{独立}, \\ A, \\overline{B} \\text{独立}, \\ \\overline{A}, B \\text{独立}；\\text{而又} \\\\&amp; P(\\overline{A}\\overline{B}) = P(\\overline{A})\\cdot P(\\overline{B}) = \\frac{1}{9}, \\\\&amp; \\quad P(\\overline{A}\\overline{B}) = P(\\overline{A}\\overline{B}) \\\\&amp; \\Rightarrow P(A)\\cdot P(\\overline{B}) = P(\\overline{A})\\cdot P(B) \\\\&amp; \\quad \\Rightarrow P(\\overline{A}) = P(\\overline{B}).\\end{aligned}\">\\begin{aligned}&amp; \\text{由事件}A,B \\text{独立} \\Rightarrow \\overline{A}, \\overline{B} \\text{独立}, \\ A, \\overline{B} \\text{独立}, \\ \\overline{A}, B \\text{独立}；\\text{而又} \\\\&amp; P(\\overline{A}\\overline{B}) = P(\\overline{A})\\cdot P(\\overline{B}) = \\frac{1}{9}, \\\\&amp; \\quad P(\\overline{A}\\overline{B}) = P(\\overline{A}\\overline{B}) \\\\&amp; \\Rightarrow P(A)\\cdot P(\\overline{B}) = P(\\overline{A})\\cdot P(B) \\\\&amp; \\quad \\Rightarrow P(\\overline{A}) = P(\\overline{B}).\\end{aligned}</div>"
