      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{设随机变量} \\\\ X_i &amp;= \\begin{cases} 1, \\text{第个房间有人} \\\\ 0, \\text{第个房间无人} \\end{cases} (i=1,2,\\cdots,15), \\\\ \\text{则} X=\\sum_{i=1}^{15} X_i, \\text{且} X_i \\text{都服从同一分布，于是} \\\\ P\\{X_i=0\\}&amp;=\\left(\\frac{14}{15}\\right)^{10}, \\ P\\{X_i=1\\}=1-P\\{X_i=0\\}=1-\\left(\\frac{14}{15}\\right)^{10} \\\\ \\text{于是} X_i \\text{服从} 0-1 \\text{分布} \\\\ \\begin{array}{|c|c|c|} \\hline X_i &amp; 0 &amp; 1 \\\\ \\hline p &amp; \\left(\\frac{14}{15}\\right)^{10} &amp; 1-\\left(\\frac{14}{15}\\right)^{10} \\\\ \\hline \\end{array} \\\\ \\text{故} \\\\ E(X_i)&amp;=1-\\left(\\frac{14}{15}\\right)^{10} \\approx 0.498 \\ (i=1,2,\\cdots,15), \\\\ E(X)&amp;=\\sum_{i=1}^{15} E(X_i)=15 \\times 0.498=7.47.\\end{aligned}\">\\begin{aligned} \\text{设随机变量} \\\\ X_i &amp;= \\begin{cases} 1, \\text{第个房间有人} \\\\ 0, \\text{第个房间无人} \\end{cases} (i=1,2,\\cdots,15), \\\\ \\text{则} X=\\sum_{i=1}^{15} X_i, \\text{且} X_i \\text{都服从同一分布，于是} \\\\ P\\{X_i=0\\}&amp;=\\left(\\frac{14}{15}\\right)^{10}, \\ P\\{X_i=1\\}=1-P\\{X_i=0\\}=1-\\left(\\frac{14}{15}\\right)^{10} \\\\ \\text{于是} X_i \\text{服从} 0-1 \\text{分布} \\\\ \\begin{array}{|c|c|c|} \\hline X_i &amp; 0 &amp; 1 \\\\ \\hline p &amp; \\left(\\frac{14}{15}\\right)^{10} &amp; 1-\\left(\\frac{14}{15}\\right)^{10} \\\\ \\hline \\end{array} \\\\ \\text{故} \\\\ E(X_i)&amp;=1-\\left(\\frac{14}{15}\\right)^{10} \\approx 0.498 \\ (i=1,2,\\cdots,15), \\\\ E(X)&amp;=\\sum_{i=1}^{15} E(X_i)=15 \\times 0.498=7.47.\\end{aligned}</div>"
