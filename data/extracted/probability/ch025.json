_2}\\overline{A_3})\\cup(\\overline{A_1}\\overline{A_2}A_3\\}&amp;=P\\{A_1\\overline{A_2}A_3\\}+P\\{\\overline{A_1}\\overline{A_2}A_3\\}+P\\{\\overline{A_1}\\overline{A_2}A_3\\}&amp;=P\\{A_1\\}P\\{\\overline{A_3}\\}+P\\{\\overline{A_1}\\}P\\{\\overline{A_2}\\}P\\{A_3\\}=\\frac{6}{24}, \\\\ P\\{X=2\\}&amp;=P\\{(\\overline{A_1}A_2A_3)\\cup(\\overline{A_1}\\overline{A_2}A_3)\\cup(\\overline{A_1}A_2\\overline{A_3}\\}&amp;=P\\{(\\overline{A_1}A_2A_3\\}+P\\{(\\overline{A_1}A_2A_3\\}+P\\{(\\overline{A_1}A_2\\overline{A_3}\\})&amp;=P\\{\\overline{A_1}\\}P\\{A_2\\}P\\{A_3\\}+P\\{\\overline{A_1}\\}P\\{\\overline{A_2}\\}P\\{A_3\\}+P\\{A_1\\}P\\{A_2\\}P\\{\\overline{A_3}\\}=\\frac{11}{24}, \\\\ P\\{X=3\\}&amp;=P\\{A_1A_2A_3\\}=P\\{A_1\\}P\\{A_2\\}P\\{A_3\\}=\\frac{6}{24}. \\end{aligned}</div>"
