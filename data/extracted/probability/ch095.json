      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}\\text{设随机变量}X \\text{服从拉普拉斯分布，其概率密度为}\\\\f(x)=\\frac{1}{2\\lambda}e^{-\\frac{|x|}{\\lambda}},-\\infty &lt; x &lt; +\\infty ,\\\\ \\text{其中} \\lambda &gt; 0 \\text{为常数，则} X \\text{的} k \\text{阶中心矩为}() .\\end{aligned}\">\\begin{aligned}\\text{设随机变量}X \\text{服从拉普拉斯分布，其概率密度为}\\\\f(x)=\\frac{1}{2\\lambda}e^{-\\frac{|x|}{\\lambda}},-\\infty &lt; x &lt; +\\infty ,\\\\ \\text{其中} \\lambda &gt; 0 \\text{为常数，则} X \\text{的} k \\text{阶中心矩为}() .\\end{aligned}</div>",
      "options": [
        {
          "label": "A",
