      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{由二项展开式}(1+x)^{2}=1+\\alpha x+\\frac{\\alpha(\\alpha-1)}{2!}x^{2}+\\cdots\\ (-1&lt;x&lt;1),\\ \\omega\\\\&amp;\\sqrt[3]{78}=\\sqrt[3]{3^{4}-3}=3(1-\\frac{1}{3^{2}})^{\\frac{1}{4}},\\ \\text{取}\\ \\alpha=\\frac{1}{4},\\ x=-\\frac{1}{3^{3}}; \\text{可得}\\omega\\\\&amp;\\sqrt[3]{78}=3(1-\\frac{1}{3^{2}})^{\\frac{1}{4}}=3\\bigg[1+\\frac{1}{4}\\cdot(-\\frac{1}{3^{2}})+\\frac{1}{4}\\frac{1}{4}-1)\\cdot\\frac{1}{2}\\cdot(-\\frac{1}{3^{2}})^{2}+\\cdots\\bigg]\\\\&amp;\\qquad=3\\bigg(1-\\frac{1}{4}\\cdot\\frac{1}{3^{3}}-\\frac{1}{4}\\cdot\\frac{3}{4}-\\frac{1}{21}\\cdot\\frac{1}{3^{3}}-\\cdots\\bigg),\\omega\\\\&amp;\\text{取前两项的和作为}\\sqrt[3]{78}\\text{的近似值}，\\text{其误差为}\\omega\\\\&amp;|\\gamma_{2}|\\leq\\frac{1}{4}\\cdot\\frac{3}{4}\\cdot\\frac{1}{4}\\cdot\\frac{1}{21}\\cdot\\frac{1}{3^{3}}=\\frac{1}{2\\cdot 4^{2}\\cdot 3^{3}}&lt;\\cdot=\\frac{2}{5^{2}\\cdot 3^{3}}&lt;0.001,\\omega\\\\&amp;\\text{故取近似值为}\\sqrt[3]{240}\\approx3\\big(1-\\frac{1}{4}\\cdot\\frac{1}{3^{3}}\\big)\\approx 2.972\\omega\\end{aligned}\">\\begin{aligned}&amp;\\text{由二项展开式}(1+x)^{2}=1+\\alpha x+\\frac{\\alpha(\\alpha-1)}{2!}x^{2}+\\cdots\\ (-1&lt;x&lt;1),\\ \\omega\\\\&amp;\\sqrt[3]{78}=\\sqrt[3]{3^{4}-3}=3(1-\\frac{1}{3^{2}})^{\\frac{1}{4}},\\ \\text{取}\\ \\alpha=\\frac{1}{4},\\ x=-\\frac{1}{3^{3}}; \\text{可得}\\omega\\\\&amp;\\sqrt[3]{78}=3(1-\\frac{1}{3^{2}})^{\\frac{1}{4}}=3\\bigg[1+\\frac{1}{4}\\cdot(-\\frac{1}{3^{2}})+\\frac{1}{4}\\frac{1}{4}-1)\\cdot\\frac{1}{2}\\cdot(-\\frac{1}{3^{2}})^{2}+\\cdots\\bigg]\\\\&amp;\\qquad=3\\bigg(1-\\frac{1}{4}\\cdot\\frac{1}{3^{3}}-\\frac{1}{4}\\cdot\\frac{3}{4}-\\frac{1}{21}\\cdot\\frac{1}{3^{3}}-\\cdots\\bigg),\\omega\\\\&amp;\\text{取前两项的和作为}\\sqrt[3]{78}\\text{的近似值}，\\text{其误差为}\\omega\\\\&amp;|\\gamma_{2}|\\leq\\frac{1}{4}\\cdot\\frac{3}{4}\\cdot\\frac{1}{4}\\cdot\\frac{1}{21}\\cdot\\frac{1}{3^{3}}=\\frac{1}{2\\cdot 4^{2}\\cdot 3^{3}}&lt;\\cdot