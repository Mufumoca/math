      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} &amp; \\text{由于} &amp; \\sin x = \\sum_{n=0}^{\\infty} (-1)^{n} \\frac{x^{2n+1}}{(2n+1)!} \\; , \\; \\; x \\in (-\\infty, \\infty) \\; ; \\\\ &amp; \\text{则} &amp; \\sin 11^{\\circ} = \\sin \\frac{11 \\pi}{180} = \\sum_{n=0}^{\\infty} (-1)^{n} \\frac{1}{(2n+1)!} \\left( \\frac{\\pi}{180} \\right)^{2n+1} = \\frac{11 \\pi}{180} - \\frac{1}{6} \\times \\left( \\frac{11 \\pi}{180} \\right)^{3} + \\frac{1}{120} \\times \\left( \\frac{11 \\pi}{180} \\right)^{5} - \\cdots , \\\\ &amp; \\text{取前两项的和和作为} \\sin 9^{\\circ} \\text{的近似值，其误差为} &amp; \\left| z_{2} \\right| \\leq \\frac{1}{120} \\times \\left( \\frac{11 \\pi}{180} \\right)^{5} &lt; \\frac{1}{120} \\times \\left( \\frac{1}{5} \\right)^{5} = \\frac{1}{375000} \\; , \\\\ &amp; \\text{所以} \\; \\sin 9^{\\circ} \\approx \\frac{11 \\pi}{180} - \\frac{1}{6} \\times \\left( \\frac{11 \\pi}{180} \\right)^{3} \\approx 0.19081 \\end{aligned}\">\\begin{aligned} &amp; \\text{由于} &amp; \\sin x = \\sum_{n=0}^{\\infty} (-1)^{n} \\frac{x^{2n+1}}{(2n+1)!} \\; , \\; \\; x \\in (-\\infty, \\infty) \\; ; \\\\ &amp; \\text{则} &amp; \\sin 11^{\\circ} = \\sin \\frac{11 \\pi}{180} = \\sum_{n=0}^{\\infty} (-1)^{n} \\frac{1}{(2n+1)!} \\left( \\frac{\\pi}{180} \\right)^{2n+1} = \\frac{11 \\pi}{180} - \\frac{1}{6} \\times \\left( \\frac{11 \\pi}{180} \\right)^{3} + \\frac{1}{120} \\times \\left( \\frac{11 \\pi}{180} \\right)^{5} - \\cdots , \\\\ &amp; \\text{取前两项的和和作为} \\sin 9^{\\circ} \\text{的近似值，其误差为} &amp; \\left| z_{2} \\right| \\leq \\frac{1}{120} \\times \\left( \\frac{11 \\pi}{180} \\right)^{5} &lt; \\frac{1}{120} \\times \\left( \\frac{1}{5} \\right)^{5} = \\frac{1}{375000} \\; , \\\\ &amp; \\text{所以} \\; \\sin 9^{\\circ} \\approx \\frac{11 \\pi}{180} - \\frac{1}{6} \\times \\left( \\frac{11 \\pi}{180} \\right)^{3} \\approx 0.19081 \\end{aligned}</div>"
