    {
      "id": "q0002",
      "number": 2,
      "header": "#2-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\Sigma:(x-1)^{2}+(y-1)^{2}+(z-1)^{2}=R^{2} \\text{的外侧，则}\\iint x^{2}dydz+y^{2}dxdz+z^{2}dxdy=[\\quad].\">\\Sigma:(x-1)^{2}+(y-1)^{2}+(z-1)^{2}=R^{2} \\text{的外侧，则}\\iint x^{2}dydz+y^{2}dxdz+z^{2}dxdy=[\\quad].</span>",
      "options": [
        {
