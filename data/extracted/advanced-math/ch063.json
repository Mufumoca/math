      "id": "q0001",
      "number": 1,
      "header": "#1-Averge",
      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l}f(x)\\text{在}[a,b]\\text{上可导，且}f^{\\prime}(x)+f^{2}(x)-\\int_{a}^{x}f(t)dt=0\\,,\\int_{a}^{b}f(t)dt=0\\,,\\text{则}\\\\ \\int_{a}^{x}f(t)dt\\text{在}(a,b)\\text{内必[}\\quad]. \\end{array}\">\\begin{array}{l}f(x)\\text{在}[a,b]\\text{上可导，且}f^{\\prime}(x)+f^{2}(x)-\\int_{a}^{x}f(t)dt=0\\,,\\int_{a}^{b}f(t)dt=0\\,,\\text{则}\\\\ \\int_{a}^{x}f(t)dt\\text{在}(a,b)\\text{内必[}\\quad]. \\end{array}</div>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{恒为正}\">\\text{恒为正}</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\textbf{恒为零}\">\\textbf{恒为零}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\textbf{变号}\">\\textbf{变号}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\textbf{恒为负}\">\\textbf{恒为负}</span>"
        }
      ],
      "answer": "B",
      "answer_index": 1,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {解答 令} F (x) = \\int_ {a} ^ {x} f (t) d t, \\text {则} F (a) = F (b) = 0, \\text {若连续函数} F (x) \\text {在} (a, b) \\text {内能取正值，则} F (x) \\text {在} (a, b) \\text {内最大值必大于} 0, \\text {记最大值在} x _ {0} \\text {点取到，即} \\\\ F (x _ {0}) \\text {是正最大值，也是极大值，故} F ^ {\\prime} (x _ {0}) = 0, \\text {进而} f (x _ {0}) = 0. \\text {又} \\\\ F ^ {\\prime \\prime} (x _ {0}) = f ^ {\\prime} (x _ {0}) = F (x _ {0}) - f ^ {2} (x _ {0}) = F (x _ {0}) &gt; 0, \\text {则} x _ {0} \\text {是} F (x) \\text {极小值，产生矛盾，这说明} F (x) \\text {在} (a, b) \\text {内能不可取正值；同理可证} F (x) \\text {在} (a, b) \\text {内也不可能取负；更不能变号。} \\end{array}\">\\begin{array}{l} \\text {解答 令} F (x) = \\int_ {a} ^ {x} f (t) d t, \\text {则} F (a) = F (b) = 0, \\text {若连续函数} F (x) \\text {在} (a, b) \\text {内能取正值，则} F (x) \\text {在} (a, b) \\text {内最大值必大于} 0, \\text {记最大值在} x _ {0} \\text {点取到，即} \\\\ F (x _ {0}) \\text {是正最大值，也是极大值，故} F ^ {\\prime} (x _ {0}) = 0, \\text {进而} f (x _ {0}) = 0. \\text {又} \\\\ F ^ {\\prime \\prime} (x _ {0}) = f ^ {\\prime} (x _ {0}) = F (x _ {0}) - f ^ {2} (x _ {0}) = F (x _ {0}) &gt; 0, \\text {则} x _ {0} \\text {是} F (x) \\text {极小值，产生矛盾，这说明} F (x) \\text {在} (a, b) \\text {内能不可取正值；同理可证} F (x) \\text {在} (a, b) \\text {内也不可能取负；更不能变号。} \\end{array}</div>"
