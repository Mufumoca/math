        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{对角线约减少了} 2 . 8 \\, c m ;\">\\text{对角线约减少了} 2 . 8 \\, c m ;</span>"
