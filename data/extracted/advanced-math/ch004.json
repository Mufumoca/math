      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;\\text{设}\\lim_{x\\rightarrow x_{0}}f(x)=A\\,,\\,\\,\\, \\text{则}\\,\\forall\\,\\varepsilon&gt;0\\,,\\,\\,\\,\\exists\\,\\delta&gt;0\\,,\\,\\,\\, \\text{当}\\,0&lt;|x-x_{0}|&lt;\\delta\\,\\text{时，都有}\\,\\big{|}f(x)-A\\big{|}&lt;\\varepsilon\\,,\\\\&amp;\\quad\\text{即}\\,\\\\&amp;A-\\varepsilon&lt;f(x)&lt;A+\\varepsilon\\,,\\,\\, \\text{取}M=\\max\\{\\big{|}A-\\varepsilon\\big{|},\\big{|}A+\\varepsilon\\big{|}\\},\\,\\, \\text{则有}\\big{|}f(x)\\big{|}&lt;M\\,.\\text{所有}f(x)\\,\\, \\text{在}x_{0}\\text{的去心邻域}\\stackrel{\\circ}{U}(x_{0},\\delta)\\,\\, \\text{内有界}.\\end{aligned}\">\\begin{aligned}&amp;\\text{设}\\lim_{x\\rightarrow x_{0}}f(x)=A\\,,\\,\\,\\, \\text{则}\\,\\forall\\,\\varepsilon&gt;0\\,,\\,\\,\\,\\exists\\,\\delta&gt;0\\,,\\,\\,\\, \\text{当}\\,0&lt;|x-x_{0}|&lt;\\delta\\,\\text{时，都有}\\,\\big{|}f(x)-A\\big{|}&lt;\\varepsilon\\,,\\\\&amp;\\quad\\text{即}\\,\\\\&amp;A-\\varepsilon&lt;f(x)&lt;A+\\varepsilon\\,,\\,\\, \\text{取}M=\\max\\{\\big{|}A-\\varepsilon\\big{|},\\big{|}A+\\varepsilon\\big{|}\\},\\,\\, \\text{则有}\\big{|}f(x)\\big{|}&lt;M\\,.\\text{所有}f(x)\\,\\, \\text{在}x_{0}\\text{的去心邻域}\\stackrel{\\circ}{U}(x_{0},\\delta)\\,\\, \\text{内有界}.\\end{aligned}</div>"
