      "header": "#1-Averge",
      "difficulty": "Averge",
      "prompt_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {设}f(x) \\text {是以}2\\pi \\text {为周期的分段连续函数，又设}f(x) \\text {是奇函数且满足} \\\\ f\\left(x+\\frac{\\pi}{2}\\right)=-f\\left(\\frac{\\pi}{2}-x\\right),\\text {则}f(x) \\text {的傅里叶系数}b_{2n-1}=( ),n=1,2,3,\\cdots \\end{array}\">\\begin{array}{l} \\text {设}f(x) \\text {是以}2\\pi \\text {为周期的分段连续函数，又设}f(x) \\text {是奇函数且满足} \\\\ f\\left(x+\\frac{\\pi}{2}\\right)=-f\\left(\\frac{\\pi}{2}-x\\right),\\text {则}f(x) \\text {的傅里叶系数}b_{2n-1}=( ),n=1,2,3,\\cdots \\end{array}</div>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { \\pi } { 2 } ;\">\\frac { \\pi } { 2 } ;</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\mathbf { 1 } ;\">\\mathbf { 1 } ;</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"- \\frac { \\pi } { 2 } \\, .\">- \\frac { \\pi } { 2 } \\, .</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\mathbf { 0 } ;\">\\mathbf { 0 } ;</span>"
        }
      ],
      "answer": "D",
      "answer_index": 3,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}b_{2n-1}&amp;=\\frac{2}{\\pi}\\int_{0}^{\\pi}f(x)\\sin(2n-1)xdx=\\frac{2}{\\pi}\\left[\\int_{0}^{\\frac{\\pi}{2}}f(x)\\sin(2n-1)xdx+\\int_{\\frac{\\pi}{2}}^{\\pi}f(x)\\sin(2n-1)xdx\\right]\\\\&amp;=\\frac{2}{\\pi}\\left[-\\int_{\\frac{\\pi}{2}}^{0}f(\\frac{\\pi}{2}-x)\\sin(2n-1)(\\frac{\\pi}{2}-x)dx+\\int_{0}^{\\frac{\\pi}{2}}f(x+\\frac{\\pi}{2})\\sin(2n-1)(x+\\frac{\\pi}{2})dx\\right]\\\\&amp;=\\frac{2}{\\pi}\\int_{0}^{\\frac{\\pi}{2}}f(\\frac{\\pi}{2}-x)\\left(\\sin(2n-1)(\\frac{\\pi}{2}-x)-\\sin(2n-1)(x+\\frac{\\pi}{2})\\right)dx=0.\\end{aligned}\">\\begin{aligned}b_{2n-1}&amp;=\\frac{2}{\\pi}\\int_{0}^{\\pi}f(x)\\sin(2n-1)xdx=\\frac{2}{\\pi}\\left[\\int_{0}^{\\frac{\\pi}{2}}f(x)\\sin(2n-1)xdx+\\int_{\\frac{\\pi}{2}}^{\\pi}f(x)\\sin(2n-1)xdx\\right]\\\\&amp;=\\frac{2}{\\pi}\\left[-\\int_{\\frac{\\pi}{2}}^{0}f(\\frac{\\pi}{2}-x)\\sin(2n-1)(\\frac{\\pi}{2}-x)dx+\\int_{0}^{\\frac{\\pi}{2}}f(x+\\frac{\\pi}{2})\\sin(2n-1)(x+\\frac{\\pi}{2})dx\\right]\\\\&amp;=\\frac{2}{\\pi}\\int_{0}^{\\frac{\\pi}{2}}f(\\frac{\\pi}{2}-x)\\left(\\sin(2n-1)(\\frac{\\pi}{2}-x)-\\sin(2n-1)(x+\\frac{\\pi}{2})\\right)dx=0.\\end{aligned}</div>"
