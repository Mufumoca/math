      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\mathit{grad}u&amp;=\\left\\{\\frac{\\partial u}{\\partial x},\\frac{\\partial u}{\\partial y},\\frac{\\partial u}{\\partial z}\\right\\},\\\\ \\text{解析：} \\quad \\mathit{rot}\\left(\\mathit{grad}u\\right)&amp;=\\begin{vmatrix} \\overline{i}&amp;\\overline{j}&amp;\\overline{k} \\\\ \\frac{\\partial}{\\partial x}&amp;\\frac{\\partial}{\\partial y}&amp;\\frac{\\partial}{\\partial x} \\\\ \\frac{\\partial u}{\\partial x}&amp;\\frac{\\partial u}{\\partial y}&amp;\\frac{\\partial u}{\\partial z} \\end{vmatrix}=\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial z\\partial y}-\\frac{\\partial^2 u}{\\partial y\\partial z}\\end{pmatrix}\\overline{i}-\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial z\\partial x}-\\frac{\\partial^2 u}{\\partial x\\partial z}\\end{pmatrix}\\overline{j}-\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial y\\partial x}-\\frac{\\partial^2 u}{\\partial x\\partial y}\\end{pmatrix}\\overline{k}=0\\end{aligned}\">\\begin{aligned} \\mathit{grad}u&amp;=\\left\\{\\frac{\\partial u}{\\partial x},\\frac{\\partial u}{\\partial y},\\frac{\\partial u}{\\partial z}\\right\\},\\\\ \\text{解析：} \\quad \\mathit{rot}\\left(\\mathit{grad}u\\right)&amp;=\\begin{vmatrix} \\overline{i}&amp;\\overline{j}&amp;\\overline{k} \\\\ \\frac{\\partial}{\\partial x}&amp;\\frac{\\partial}{\\partial y}&amp;\\frac{\\partial}{\\partial x} \\\\ \\frac{\\partial u}{\\partial x}&amp;\\frac{\\partial u}{\\partial y}&amp;\\frac{\\partial u}{\\partial z} \\end{vmatrix}=\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial z\\partial y}-\\frac{\\partial^2 u}{\\partial y\\partial z}\\end{pmatrix}\\overline{i}-\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial z\\partial x}-\\frac{\\partial^2 u}{\\partial x\\partial z}\\end{pmatrix}\\overline{j}-\\begin{pmatrix}\\frac{\\partial^2 u}{\\partial y\\partial x}-\\frac{\\partial^2 u}{\\partial x\\partial y}\\end{pmatrix}\\overline{k}=0\\end{aligned}</div>"
