      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text {解答：} \\quad \\text {平面} \\Pi_{2} \\text {上任取一点} M(0,1,0)，\\text{则} M \\text{点到} \\Pi_{1} \\text{的距离即为两平行平面间的距离}，\\text{即} \\\\ d = \\frac{|10 \\times 0 + 2 \\times 1 - 2 \\times 0 - 5|}{\\sqrt{10^{2} + 2^{2} + (-2)^{2}}} = \\frac{\\sqrt{3}}{6}.\\end{array}\">\\begin{array}{l} \\text {解答：} \\quad \\text {平面} \\Pi_{2} \\text {上任取一点} M(0,1,0)，\\text{则} M \\text{点到} \\Pi_{1} \\text{的距离即为两平行平面间的距离}，\\text{即} \\\\ d = \\frac{|10 \\times 0 + 2 \\times 1 - 2 \\times 0 - 5|}{\\sqrt{10^{2} + 2^{2} + (-2)^{2}}} = \\frac{\\sqrt{3}}{6}.\\end{array}</div>"
