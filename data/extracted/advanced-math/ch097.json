      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\dot{a}, \\dot{b}, \\dot{c} \\text{均为非零向量，其中任意两个不共线，但} \\dot{a} + \\dot{b} \\text{与} \\dot{c} \\text{共线，} \\dot{b} + \\dot{c} \\text{与} \\dot{a} \\text{共线，则[} \\quad].\">\\dot{a}, \\dot{b}, \\dot{c} \\text{均为非零向量，其中任意两个不共线，但} \\dot{a} + \\dot{b} \\text{与} \\dot{c} \\text{共线，} \\dot{b} + \\dot{c} \\text{与} \\dot{a} \\text{共线，则[} \\quad].</span>",
