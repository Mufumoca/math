      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} \\text{解答：设} M \\text{的坐标为} (x,y,z), \\text{已知} AM=2MB, \\text{由定比分点的性质可得：} \\\\ x=\\frac{3+2\\cdot 7}{1+2}=\\frac{17}{3}, \\quad y=\\frac{3+2\\cdot (-2)}{1+2}=-\\frac{2}{3}, \\quad z=\\frac{(-1)+2\\cdot 3}{1+2}=\\frac{5}{3}, \\\\ \\text{即}\\overrightarrow{OM}=\\frac{1}{3}(17,-2,5). \\end{array}\">\\begin{array}{l} \\text{解答：设} M \\text{的坐标为} (x,y,z), \\text{已知} AM=2MB, \\text{由定比分点的性质可得：} \\\\ x=\\frac{3+2\\cdot 7}{1+2}=\\frac{17}{3}, \\quad y=\\frac{3+2\\cdot (-2)}{1+2}=-\\frac{2}{3}, \\quad z=\\frac{(-1)+2\\cdot 3}{1+2}=\\frac{5}{3}, \\\\ \\text{即}\\overrightarrow{OM}=\\frac{1}{3}(17,-2,5). \\end{array}</div>"
