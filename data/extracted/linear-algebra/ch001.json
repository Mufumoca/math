      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} \\text{方程组的系数行列式为} \\quad D=\\begin{vmatrix} 1 &amp; 1 &amp; 1 &amp; 1 \\\\ 2 &amp; 3 &amp; 4 &amp; 5 \\\\ 4 &amp; 9 &amp; 16 &amp; 25 \\\\ 8 &amp; 27 &amp; 64 &amp; 125 \\end{vmatrix}, \\text{由克莱姆法则可知} x_1=\\frac{D_1}{D}, \\; x_2=\\frac{D_2}{D}, \\\\ x_3=\\frac{D_3}{D}, \\; x_4=\\frac{D_4}{D}, \\text{由于} D_1,D_2,D_3 \\text{中都有相同的两列，因此行列式都为零，} \\\\ \\text{且} D_4=D, \\text{故} x_1=0, \\; x_2=0, \\; x_3=0, \\; x_4=1.\\end{aligned}\">\\begin{aligned} \\text{方程组的系数行列式为} \\quad D=\\begin{vmatrix} 1 &amp; 1 &amp; 1 &amp; 1 \\\\ 2 &amp; 3 &amp; 4 &amp; 5 \\\\ 4 &amp; 9 &amp; 16 &amp; 25 \\\\ 8 &amp; 27 &amp; 64 &amp; 125 \\end{vmatrix}, \\text{由克莱姆法则可知} x_1=\\frac{D_1}{D}, \\; x_2=\\frac{D_2}{D}, \\\\ x_3=\\frac{D_3}{D}, \\; x_4=\\frac{D_4}{D}, \\text{由于} D_1,D_2,D_3 \\text{中都有相同的两列，因此行列式都为零，} \\\\ \\text{且} D_4=D, \\text{故} x_1=0, \\; x_2=0, \\; x_3=0, \\; x_4=1.\\end{aligned}</div>"
