    {
      "id": "q0007",
      "number": 7,
      "header": "#7-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{在} [0,+\\infty) \\text{上，} \\sin kt * \\sin kt = (\\quad), \\text{其中常数} k \\neq 0.\">\\text{在} [0,+\\infty) \\text{上，} \\sin kt * \\sin kt = (\\quad), \\text{其中常数} k \\neq 0.</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 k } \\sin k t - \\frac { t } { 2 } \\cos k t\">\\frac { 1 } { 2 k } \\sin k t - \\frac { t } { 2 } \\cos k t</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 k } \\sin k t + \\frac { t } { 2 } \\cos k t\">\\frac { 1 } { 2 k } \\sin k t + \\frac { t } { 2 } \\cos k t</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 k } \\cos k t - \\frac { t } { 2 } \\sin k t\">\\frac { 1 } { 2 k } \\cos k t - \\frac { t } { 2 } \\sin k t</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 k } \\cos k t + \\frac { t } { 2 } \\sin k t\">\\frac { 1 } { 2 k } \\cos k t + \\frac { t } { 2 } \\sin k t</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{array}{l} { r l } \\sin k t * \\sin k t &amp; = \\int _ { 0 } ^ { t } \\sin k \\tau \\sin \\bigl ( t - \\tau \\bigr ) d \\tau = \\frac { 1 } { 2 } \\int _ { 0 } ^ { t } \\bigl ( \\cos \\bigl ( 2 k \\tau - k t \\bigr ) - \\cos k t \\bigr ) d \\tau \\\\ &amp; = \\frac { 1 } { 2 k } \\sin k t - \\frac { t } { 2 } \\cos k t \\end{array}\">\\begin{array}{l} { r l } \\sin k t * \\sin k t &amp; = \\int _ { 0 } ^ { t } \\sin k \\tau \\sin \\bigl ( t - \\tau \\bigr ) d \\tau = \\frac { 1 } { 2 } \\int _ { 0 } ^ { t } \\bigl ( \\cos \\bigl ( 2 k \\tau - k t \\bigr ) - \\cos k t \\bigr ) d \\tau \\\\ &amp; = \\frac { 1 } { 2 k } \\sin k t - \\frac { t } { 2 } \\cos k t \\end{array}</div>"
