      "difficulty": "Easy",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{在} [0,+\\infty) \\text{上，} \\ t * e^{t} = (\\quad).\">\\text{在} [0,+\\infty) \\text{上，} \\ t * e^{t} = (\\quad).</span>",
      "options": [
        {
          "label": "A",
