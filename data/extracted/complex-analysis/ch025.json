        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 3 } t ^ { 3 }\">\\frac { 1 } { 3 } t ^ { 3 }</span>"
