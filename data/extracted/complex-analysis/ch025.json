    {
      "id": "q0003",
      "number": 3,
      "header": "#3-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{在} [0,+\\infty) \\text{上，} \\ (e^{-2t}\\sin 3t)*(e^{-2t}\\sin 3t)=(\\ \\ ).\">\\text{在} [0,+\\infty) \\text{上，} \\ (e^{-2t}\\sin 3t)*(e^{-2t}\\sin 3t)=(\\ \\ ).</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\sin 3t - t \\cos 3t)\">\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\sin 3t - t \\cos 3t)</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\sin 3t+t\\cos 3t)\">\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\sin 3t+t\\cos 3t)</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{2}e^{-2t}(t\\cos 3t-\\frac{1}{3}\\sin 3t)\">\\frac{1}{2}e^{-2t}(t\\cos 3t-\\frac{1}{3}\\sin 3t)</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\cos 3t+t\\sin 3t)\">\\frac{1}{2}e^{-2t}(\\frac{1}{3}\\cos 3t+t\\sin 3t)</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}&amp;(e^{-2t}\\sin 3t)*(e^{-2t}\\sin 3t)=\\int_{0}^{t}\\Bigl(e^{-2\\tau}\\sin 3\\tau\\Bigr)\\Bigl(e^{-2(t-\\tau)}\\sin 3(t-\\tau)\\Bigr)d\\tau\\\\&amp;=e^{-2t}\\int_{0}^{t}(\\sin 3\\tau)\\sin 3(t-\\tau)d\\tau\\\\&amp;=-\\frac{1}{2}e^{-2t}\\int_{0}^{t}\\bigl(\\cos 3t-\\cos 3(2\\tau-t)\\bigr)d\\tau\\\\&amp;=-\\frac{1}{2}e^{-2t}(t\\cos 3t-\\frac{1}{3}\\sin 3t)\\end{aligned}\">\\begin{aligned}&amp;(e^{-2t}\\sin 3t)*(e^{-2t}\\sin 3t)=\\int_{0}^{t}\\Bigl(e^{-2\\tau}\\sin 3\\tau\\Bigr)\\Bigl(e^{-2(t-\\tau)}\\sin 3(t-\\tau)\\Bigr)d\\tau\\\\&amp;=e^{-2t}\\int_{0}^{t}(\\sin 3\\tau)\\sin 3(t-\\tau)d\\tau\\\\&amp;=-\\frac{1}{2}e^{-2t}\\int_{0}^{t}\\bigl(\\cos 3t-\\cos 3(2\\tau-t)\\bigr)d\\tau\\\\&amp;=-\\frac{1}{2}e^{-2t}(t\\cos 3t-\\frac{1}{3}\\sin 3t)\\end{aligned}</div>"
    },
    {
      "id": "q0004",
      "number": 4,
      "header": "#4-Averge",
      "difficulty": "Averge",
      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{在} [ 0 , + \\infty ) \\text{上，} \\sin t * \\cos t = ( \\quad ) . \\uparrow\">\\text{在} [ 0 , + \\infty ) \\text{上，} \\sin t * \\cos t = ( \\quad ) . \\uparrow</span>",
      "options": [
        {
          "label": "A",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 } t \\sin t\">\\frac { 1 } { 2 } t \\sin t</span>"
        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\frac { 1 } { 2 } t \\cos t\">\\frac { 1 } { 2 } t \\cos t</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\boldsymbol{t}^{2} \\sin t\">\\boldsymbol{t}^{2} \\sin t</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"t^{2}\\cos t\">t^{2}\\cos t</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}\\sin t \\ast \\cos t = \\int_{0}^{t} \\sin \\tau \\cos (t-\\tau) d_{z} = \\frac{1}{2} \\int_{0}^{t} ( \\sin (2 \\tau - t) + \\sin t ) d_{z} = \\frac{1}{2} t \\sin t\\end{aligned}\">\\begin{aligned}\\sin t \\ast \\cos t = \\int_{0}^{t} \\sin \\tau \\cos (t-\\tau) d_{z} = \\frac{1}{2} \\int_{0}^{t} ( \\sin (2 \\tau - t) + \\sin t ) d_{z} = \\frac{1}{2} t \\sin t\\end{aligned}</div>"
    },
    {
