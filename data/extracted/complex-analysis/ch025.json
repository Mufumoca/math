        },
        {
          "label": "B",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\boldsymbol{e}^{t}-t+\\mathbf{1}\">\\boldsymbol{e}^{t}-t+\\mathbf{1}</span>"
        },
        {
          "label": "C",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"e^{t} + t - 1\">e^{t} + t - 1</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\boldsymbol{e}^{t} + t + \\mathbf{1}\">\\boldsymbol{e}^{t} + t + \\mathbf{1}</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}t\\ast e^{t}=\\int_{0}^{t}\\tau e^{t-\\tau}d\\tau=e^{t}\\int_{0}^{t}\\tau e^{-\\tau}d\\tau=e^{t}\\left(-te^{-t}-e^{-t}+\\mathbf{1}\\right)=e^{t}-t-\\mathbf{1}_{+}\\end{aligned}\">\\begin{aligned}t\\ast e^{t}=\\int_{0}^{t}\\tau e^{t-\\tau}d\\tau=e^{t}\\int_{0}^{t}\\tau e^{-\\tau}d\\tau=e^{t}\\left(-te^{-t}-e^{-t}+\\mathbf{1}\\right)=e^{t}-t-\\mathbf{1}_{+}\\end{aligned}</div>"
