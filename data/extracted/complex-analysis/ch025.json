      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{在} [0,+\\infty) \\text{上，} 1 * e^{-t} = ( ) .\">\\text{在} [0,+\\infty) \\text{上，} 1 * e^{-t} = ( ) .</span>",
      "options": [
        {
