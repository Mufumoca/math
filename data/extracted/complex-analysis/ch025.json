          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\begin{array}{c} 1 - e ^ {t} \\end{array}\">\\begin{array}{c} 1 - e ^ {t} \\end{array}</span>"
        },
        {
          "label": "D",
          "html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\mathbf { 1 } + e ^ { t }\">\\mathbf { 1 } + e ^ { t }</span>"
        }
      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\mathbf{1} \\star e^{-t} = \\int_{0}^{t} e^{-\\tau} d_{\\tau} = -e^{-\\tau} \\left| \\begin{matrix} t \\\\ 0 \\end{matrix} \\right. = 1 - e^{-t}\">\\mathbf{1} \\star e^{-t} = \\int_{0}^{t} e^{-\\tau} d_{\\tau} = -e^{-\\tau} \\left| \\begin{matrix} t \\\\ 0 \\end{matrix} \\right. = 1 - e^{-t}</div>"
