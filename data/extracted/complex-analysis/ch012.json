      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}e^{z^{2}}-1&amp;=\\sum_{n=0}^{\\infty}\\frac{1}{n!}z^{2n}-1=\\sum_{n=1}^{\\infty}\\frac{1}{n!}z^{2n}\\\\ \\text{所以，}z=0\\text{是函数}e^{z^{2}}-1\\text{的2级零点。}\\end{aligned}\">\\begin{aligned}e^{z^{2}}-1&amp;=\\sum_{n=0}^{\\infty}\\frac{1}{n!}z^{2n}-1=\\sum_{n=1}^{\\infty}\\frac{1}{n!}z^{2n}\\\\ \\text{所以，}z=0\\text{是函数}e^{z^{2}}-1\\text{的2级零点。}\\end{aligned}</div>"
