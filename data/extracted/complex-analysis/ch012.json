      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned} ch\\frac{\\pi}{2}&amp;=\\frac{e^{\\frac{\\pi i}{2}}+e^{-\\frac{\\pi i}{2}}}{2}=\\frac{i-i}{2}=0,\\\\ chz&#x27;=shz,sh\\frac{\\pi}{2}&amp;=\\frac{e^{\\frac{\\pi i}{2}}-e^{-\\frac{\\pi i}{2}}}{2}=\\frac{i+i}{2}=i,\\\\ \\text{所以，}z&amp;=\\frac{\\pi}{2}\\text{是函数}chz\\text{的1级零点} \\end{aligned}\">\\begin{aligned} ch\\frac{\\pi}{2}&amp;=\\frac{e^{\\frac{\\pi i}{2}}+e^{-\\frac{\\pi i}{2}}}{2}=\\frac{i-i}{2}=0,\\\\ chz&#x27;=shz,sh\\frac{\\pi}{2}&amp;=\\frac{e^{\\frac{\\pi i}{2}}-e^{-\\frac{\\pi i}{2}}}{2}=\\frac{i+i}{2}=i,\\\\ \\text{所以，}z&amp;=\\frac{\\pi}{2}\\text{是函数}chz\\text{的1级零点} \\end{aligned}</div>"
