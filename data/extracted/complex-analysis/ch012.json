      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{如果}z_{0}\\text{是}f(z)\\text{的}m(m&gt;1)\\text{级零点，那么}z_{0}\\text{是}f^{\\prime}(z_{0})\\text{的(　　)级零点.}\">\\text{如果}z_{0}\\text{是}f(z)\\text{的}m(m&gt;1)\\text{级零点，那么}z_{0}\\text{是}f^{\\prime}(z_{0})\\text{的(　　)级零点.}</span>",
