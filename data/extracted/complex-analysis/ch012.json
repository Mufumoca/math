      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}f(z) &amp; \\text{在}z=0 \\text{点的泰勒展开式为} \\omega \\\\f(z) &amp;= 6 \\sum_{n=0}^{\\infty} \\frac{(-1)^{n}}{(2n+1)!} (z^{3})^{2n+1} + z^{9} - 6 z^{3} = \\frac{6}{5!} z^{15} + \\cdots \\omega \\\\ \\text{所以} z=0 \\text{是} f(z) \\text{的} 15 \\text{级零点}.\\end{aligned}\">\\begin{aligned}f(z) &amp; \\text{在}z=0 \\text{点的泰勒展开式为} \\omega \\\\f(z) &amp;= 6 \\sum_{n=0}^{\\infty} \\frac{(-1)^{n}}{(2n+1)!} (z^{3})^{2n+1} + z^{9} - 6 z^{3} = \\frac{6}{5!} z^{15} + \\cdots \\omega \\\\ \\text{所以} z=0 \\text{是} f(z) \\text{的} 15 \\text{级零点}.\\end{aligned}</div>"
