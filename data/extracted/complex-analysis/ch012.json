      ],
      "answer": "A",
      "answer_index": 0,
      "analysis_html": "<div class=\"math-tex math-block\" data-display=\"true\" data-tex=\"\\begin{aligned}f(z)=&amp;(z-z_0)^m \\varphi(z)^\\psi\\\\\\text{故}\\quad f&#x27;(z)=&amp;m(z-z_0)^{m-1}\\varphi(z)+(z-z_0)^m \\varphi&#x27;(z)^\\psi\\\\=&amp;(z-z_0)^{m-1}[m\\varphi(z)+(z-z_0)\\varphi&#x27;(z)]_\\psi\\\\=&amp;(z-z_0)^{m-1}\\psi(z)\\\\\\psi(z)\\text{在}z_0\\text{解析，且}\\psi(z_0)=m\\psi(z_0)\\neq 0,\\ \\text{故}z_0\\text{是}f&#x27;(z)\\text{的}m-1\\text{级零点}.\\end{aligned}\">\\begin{aligned}f(z)=&amp;(z-z_0)^m \\varphi(z)^\\psi\\\\\\text{故}\\quad f&#x27;(z)=&amp;m(z-z_0)^{m-1}\\varphi(z)+(z-z_0)^m \\varphi&#x27;(z)^\\psi\\\\=&amp;(z-z_0)^{m-1}[m\\varphi(z)+(z-z_0)\\varphi&#x27;(z)]_\\psi\\\\=&amp;(z-z_0)^{m-1}\\psi(z)\\\\\\psi(z)\\text{在}z_0\\text{解析，且}\\psi(z_0)=m\\psi(z_0)\\neq 0,\\ \\text{故}z_0\\text{是}f&#x27;(z)\\text{的}m-1\\text{级零点}.\\end{aligned}</div>"
