      "prompt_html": "<span class=\"math-tex math-inline\" data-display=\"false\" data-tex=\"\\text{复数}f(z)=u(x,y)+i\\,v(x,y)\\text{在点}z_{0}=x_{0}+iy_{0}\\text{处连续的充要条件是（　）.}\">\\text{复数}f(z)=u(x,y)+i\\,v(x,y)\\text{在点}z_{0}=x_{0}+iy_{0}\\text{处连续的充要条件是（　）.}</span>",
